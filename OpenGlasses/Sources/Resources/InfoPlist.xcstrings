    "NSCalendarsFullAccessUsageDescription" : {
      "comment" : "Info.plist NSCalendarsFullAccessUsageDescription: the reason iOS shows when it asks for this permission.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يصل Avenkin إلى التقويم ليخبرك بالأحداث القادمة وينشئ أحداثًا جديدة دون استخدام اليدين."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Avenkin accesses your calendar to tell you about upcoming events and create new ones hands-free."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin accede a tu calendario para avisarte de los próximos eventos y crear nuevos con manos libres."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin accède à votre calendrier pour vous informer des événements à venir et en créer de nouveaux mains libres."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Avenkin hozzáfér a naptárához, hogy tájékoztassa a közelgő eseményekről, és kéz használata nélkül újakat hozzon létre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin accede al tuo calendario per informarti sugli eventi imminenti e crearne di nuovi a mani libere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkinは、今後の予定をお知らせしたり、ハンズフリーで新しい予定を作成したりするためにカレンダーにアクセスします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin은 다가오는 일정을 알려 주고 핸즈프리로 새 일정을 만들기 위해 캘린더에 접근합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin gebruikt uw kalender om u te informeren over komende activiteiten en handsfree nieuwe aan te maken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Avenkin acessa seu calendário para informar você sobre os próximos eventos e criar novos com as mãos livres."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin обращается к вашему календарю, чтобы сообщать о предстоящих событиях и создавать новые без помощи рук."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin 访问你的日历，以便告诉你即将到来的日程，并免提创建新日程。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin 會取用你的行事曆，以告訴你即將到來的活動，並免持建立新活動。"
          }
        }
      }
    },
