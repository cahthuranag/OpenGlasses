    "NSCameraUsageDescription" : {
      "comment" : "Info.plist NSCameraUsageDescription: the reason iOS shows when it asks for this permission.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم Avenkin الكاميرا لمسح رموز الإعداد والتقاط الصور ومقاطع الفيديو ليحللها الذكاء الاصطناعي."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Avenkin uses the camera to scan setup codes and to capture photos and video for the AI to analyze."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin usa la cámara para escanear códigos de configuración y tomar fotos y videos para que la IA los analice."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin utilise l'appareil photo pour numériser les codes de configuration et prendre des photos et des vidéos que l'IA analysera."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Avenkin a kamerát beállítási kódok beolvasására, valamint fotók és videók készítésére használja, amelyeket az AI elemez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin usa la fotocamera per scansionare i codici di configurazione e per scattare foto e registrare video da far analizzare all'AI."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkinは、セットアップコードのスキャンや、AIが分析する写真・ビデオの撮影にカメラを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin은 설정 코드를 스캔하고 AI가 분석할 사진과 동영상을 촬영하기 위해 카메라를 사용합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin gebruikt de camera om configuratiecodes te scannen en foto's en video's te maken die de AI analyseert."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Avenkin usa a câmera para ler códigos de configuração e capturar fotos e vídeos para a IA analisar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin использует камеру, чтобы сканировать коды настройки, а также снимать фото и видео для анализа ИИ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin 使用相机扫描设置码，并拍摄照片和视频供 AI 分析。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin 使用相機掃描設定碼，並拍攝照片和影片供 AI 分析。"
          }
        }
      }
    },
    "NSContactsUsageDescription" : {
      "comment" : "Info.plist NSContactsUsageDescription: the reason iOS shows when it asks for this permission.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبحث Avenkin في جهات الاتصال لتتمكن من إجراء المكالمات وإرسال الرسائل وتوجيه رسائل البريد الإلكتروني بالاسم، دون استخدام اليدين."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Avenkin looks up contacts so you can make calls, send messages and address email by name, hands-free."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin busca tus contactos para que puedas hacer llamadas, enviar mensajes y escribir correos a las personas por su nombre, con manos libres."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin consulte vos contacts pour que vous puissiez appeler, envoyer des messages et adresser des courriels par le nom de la personne, mains libres."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Avenkin a névjegyek között keres, hogy név alapján, kéz használata nélkül indíthasson hívást, küldhessen üzenetet és címezhessen e-mailt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin cerca i contatti per permetterti di fare chiamate, inviare messaggi e indirizzare email per nome, a mani libere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkinは、名前を指定するだけでハンズフリーで電話をかけたり、メッセージを送ったり、メールの宛先を指定したりできるように連絡先を検索します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin은 이름만으로 핸즈프리로 전화를 걸고, 메시지를 보내고, 이메일 수신자를 지정할 수 있도록 연락처를 조회합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin zoekt contacten op, zodat u handsfree op naam kunt bellen, berichten kunt sturen en e-mails kunt adresseren."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Avenkin consulta seus contatos para que você possa fazer ligações, enviar mensagens e endereçar e-mails pelo nome, com as mãos livres."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin ищет контакты, чтобы вы могли без помощи рук звонить, отправлять сообщения и адресовать письма по имени."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin 查找联系人，让你可以免提按姓名拨打电话、发送信息和填写电子邮件收件人。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin 會查詢聯絡人，讓你可以免持依姓名撥打電話、傳送訊息及填寫電子郵件收件人。"
          }
        }
      }
    },
    "NSHealthShareUsageDescription" : {
      "comment" : "Info.plist NSHealthShareUsageDescription: the reason iOS shows when it asks for this permission.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقرأ Avenkin معدل ضربات قلبك ومعدل ضربات القلب أثناء الراحة والنوم والخطوات والتمارين من Apple Health للإجابة عن أسئلة مثل «كيف كان نومي؟» ولإطلاعك على نشاطك البدني. لا تُرسَل هذه الأرقام إلى مزوّد الذكاء الاصطناعي الذي اخترته إلا إذا فعّلت «مشاركة بيانات الصحة مع الذكاء الاصطناعي» في الإعدادات؛ وإلا فإن Avenkin ينطقها لك بنفسه وتبقى على هاتفك."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Avenkin reads your heart rate, resting heart rate, sleep, steps and workouts from Apple Health to answer questions like \"how did I sleep?\" and to tell you about your fitness activity. Only if you turn on \"Share Health Data with AI\" in Settings are these numbers sent to your chosen AI provider; otherwise Avenkin speaks them to you itself and they stay on your phone."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin lee tu frecuencia cardiaca, frecuencia cardiaca en reposo, sueño, pasos y entrenamientos de Apple Health para responder preguntas como “¿cómo dormí?” y para informarte sobre tu actividad física. Estas cifras se envían a tu proveedor de IA elegido solo si activas “Compartir datos de salud con la IA” en Configuración; de lo contrario, Avenkin te las dice en voz alta y se quedan en tu celular."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin lit votre fréquence cardiaque, votre fréquence cardiaque au repos, votre sommeil, vos pas et vos entraînements dans Apple Health pour répondre à des questions comme « Comment ai-je dormi? » et vous renseigner sur votre activité physique. Ces chiffres ne sont envoyés au fournisseur d'IA de votre choix que si vous activez « Partager les données de santé avec l'IA » dans Réglages; sinon, Avenkin vous les énonce lui-même et ils restent sur votre téléphone."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Avenkin beolvassa a pulzusszámát, a nyugalmi pulzusszámát, valamint az alvási, lépés- és edzésadatait az Apple Healthből, hogy válaszoljon az olyan kérdésekre, mint a „Hogyan aludtam?”, és tájékoztassa a fizikai aktivitásáról. Ezek a számok csak akkor kerülnek el a választott AI-szolgáltatóhoz, ha a Beállításokban bekapcsolja az „Ossza meg az egészségügyi adatokat az AI-val” lehetőséget; ellenkező esetben az Avenkin maga mondja el őket, és a telefonján maradnak."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin legge da Apple Health la frequenza cardiaca, la frequenza cardiaca a riposo, il sonno, i passi e gli allenamenti per rispondere a domande come «Come ho dormito?» e per informarti sulla tua attività fisica. Questi dati vengono inviati al fornitore di AI che hai scelto solo se attivi «Condividi i dati sanitari con l'intelligenza artificiale» in Impostazioni; altrimenti è Avenkin stesso a comunicarteli a voce e restano sul tuo telefono."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkinは、「昨夜の睡眠はどうだった？」のような質問に答えたり、フィットネスの活動状況をお知らせしたりするために、Apple Healthから心拍数、安静時心拍数、睡眠、歩数、ワークアウトを読み取ります。これらの数値が選択したAIプロバイダに送信されるのは、設定で「健康データをAIと共有」をオンにした場合のみです。オフの場合はAvenkin自身が読み上げ、データはスマートフォン内にとどまります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin은 “잠은 잘 잤어?” 같은 질문에 답하고 피트니스 활동을 알려 주기 위해 Apple Health에서 심박수, 휴식 시 심박수, 수면, 걸음 수, 운동 기록을 읽습니다. 설정에서 ‘AI와 건강 데이터 공유’를 켠 경우에만 이 수치가 선택한 AI 제공업체로 전송되며, 그렇지 않으면 Avenkin이 직접 읽어 주고 데이터는 휴대폰에만 남습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin leest uw hartslag, rusthartslag, slaap, stappen en trainingen uit Apple Health om vragen als ‘Hoe heb ik geslapen?’ te beantwoorden en u te informeren over uw fitnessactiviteit. Alleen als u ‘Gezondheidsgegevens delen met AI’ inschakelt in Instellingen, worden deze cijfers naar uw gekozen AI-aanbieder gestuurd; anders spreekt Avenkin ze zelf voor u uit en blijven ze op uw telefoon."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Avenkin lê sua frequência cardíaca, frequência cardíaca em repouso, sono, passos e treinos no Apple Health para responder a perguntas como “como eu dormi?” e informar você sobre sua atividade física. Esses números só são enviados ao provedor de IA escolhido se você ativar “Compartilhe dados de saúde com IA” em Configurações; caso contrário, o próprio Avenkin os informa em voz alta e eles ficam no seu celular."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin считывает из Apple Health ваш пульс, пульс в покое, данные о сне, шагах и тренировках, чтобы отвечать на вопросы вроде «Как мне спалось?» и рассказывать о вашей физической активности. Эти показатели отправляются выбранному вами провайдеру ИИ, только если вы включите «Делиться данными о здоровье с ИИ» в настройках; в противном случае Avenkin сам озвучивает их вам и они остаются на телефоне."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin 从 Apple Health 读取你的心率、静息心率、睡眠、步数和锻炼数据，以回答“我睡得怎么样？”之类的问题，并告诉你健身活动情况。只有在你于设置中开启“与 AI 共享健康数据”后，这些数字才会发送给你选择的 AI 提供商；否则，Avenkin 会自己为你播报，数据也会保留在你的手机上。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin 從 Apple Health 讀取你的心率、靜止心率、睡眠、步數和鍛鍊資料，以回答「我睡得怎麼樣？」之類的問題，並告訴你健身活動狀況。只有在你於「設定」中開啟「與 AI 共享健康資料」後，這些數字才會傳送給你選擇的 AI 供應商；否則 Avenkin 會自己唸給你聽，資料也會留在你的手機上。"
          }
        }
      }
    },
