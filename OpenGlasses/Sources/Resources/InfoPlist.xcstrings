{
  "sourceLanguage" : "en",
  "strings" : {
    "NSAlarmKitUsageDescription" : {
      "comment" : "Info.plist NSAlarmKitUsageDescription: the reason iOS shows when it asks for this permission.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يرنّ Avenkin المنبّهات التي تضبطها بصوتك، حتى عندما يكون الهاتف في الوضع الصامت."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Avenkin rings the alarms you set by voice, even when the phone is on silent."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin hace sonar las alarmas que configuras por voz, incluso cuando el celular está en silencio."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin fait sonner les alarmes que vous réglez par la voix, même lorsque le téléphone est en mode silencieux."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Avenkin akkor is megszólaltatja a hanggal beállított ébresztéseket, ha a telefon néma módban van."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin fa suonare le sveglie che imposti con la voce, anche quando il telefono è in modalità silenziosa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkinは、音声で設定したアラームを、スマートフォンが消音モードのときでも鳴らします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin은 휴대폰이 무음 모드일 때도 음성으로 설정한 알람을 울립니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin laat de wekkers afgaan die u met uw stem instelt, ook als de telefoon op stil staat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Avenkin toca os alarmes que você define por voz, mesmo quando o celular está no modo silencioso."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin включает будильники, которые вы установили голосом, даже когда на телефоне включен беззвучный режим."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin 会按时响起你用语音设定的闹钟，即使手机处于静音模式也不例外。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "即使手機處於靜音模式，Avenkin 也會響起你用語音設定的鬧鐘。"
          }
        }
      }
    },
    "NSAppleMusicUsageDescription" : {
      "comment" : "Info.plist NSAppleMusicUsageDescription: the reason iOS shows when it asks for this permission.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يشغّل Avenkin الموسيقى من مكتبتك أو من كتالوج Apple Music، ويضيف الموسيقى إلى مكتبتك عندما تطلب ذلك، ويتحكم في التشغيل بصوتك دون استخدام اليدين."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Avenkin plays music from your library or the Apple Music catalogue, adds music to your library when you ask, and controls playback hands-free, by voice."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin reproduce música de tu biblioteca o del catálogo de Apple Music, agrega música a tu biblioteca cuando se lo pides y controla la reproducción por voz, con manos libres."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin fait jouer de la musique de votre bibliothèque ou du catalogue Apple Music, ajoute de la musique à votre bibliothèque à votre demande et contrôle la lecture mains libres, par la voix."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Avenkin zenét játszik le a könyvtárából vagy az Apple Music katalógusából, kérésre zenét ad hozzá a könyvtárához, és hanggal, kéz használata nélkül vezérli a lejátszást."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin riproduce musica dalla tua libreria o dal catalogo di Apple Music, aggiunge musica alla tua libreria quando lo chiedi e controlla la riproduzione con la voce, a mani libere."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkinは、ライブラリやApple Musicのカタログから音楽を再生し、リクエストに応じてライブラリに音楽を追加し、音声によるハンズフリー操作で再生をコントロールします。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin은 보관함 또는 Apple Music 카탈로그의 음악을 재생하고, 요청하면 보관함에 음악을 추가하며, 음성으로 재생을 핸즈프리로 제어합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin speelt muziek af uit uw bibliotheek of de Apple Music-catalogus, voegt op uw verzoek muziek toe aan uw bibliotheek en bedient het afspelen handsfree, met uw stem."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Avenkin reproduz músicas da sua biblioteca ou do catálogo do Apple Music, adiciona músicas à sua biblioteca quando você pede e controla a reprodução por voz, com as mãos livres."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin воспроизводит музыку из вашей медиатеки или каталога Apple Music, по вашей просьбе добавляет музыку в медиатеку и управляет воспроизведением голосом, без помощи рук."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin 可播放你资料库或 Apple Music 曲库中的音乐，在你要求时将音乐添加到资料库，并通过语音免提控制播放。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin 可播放你資料庫或 Apple Music 目錄中的音樂，在你要求時將音樂加入資料庫，並透過語音免持控制播放。"
          }
        }
      }
    },
    "NSBluetoothAlwaysUsageDescription" : {
      "comment" : "Info.plist NSBluetoothAlwaysUsageDescription: the reason iOS shows when it asks for this permission.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم Avenkin تقنية Bluetooth للاتصال بنظاراتك الذكية (Ray-Ban Meta أو EVEN Realities G2)."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Avenkin uses Bluetooth to connect to your smart glasses (Ray-Ban Meta or EVEN Realities G2)."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin usa Bluetooth para conectarse a tus lentes inteligentes (Ray-Ban Meta o EVEN Realities G2)."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin utilise le Bluetooth pour se connecter à vos lunettes intelligentes (Ray-Ban Meta ou EVEN Realities G2)."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Avenkin a Bluetooth segítségével csatlakozik az okos szemüvegéhez (Ray-Ban Meta vagy EVEN Realities G2)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin usa il Bluetooth per connettersi ai tuoi occhiali intelligenti (Ray-Ban Meta o EVEN Realities G2)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkinは、スマートグラス（Ray-Ban MetaまたはEVEN Realities G2）に接続するためにBluetoothを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin은 Bluetooth를 사용하여 스마트 안경(Ray-Ban Meta 또는 EVEN Realities G2)에 연결합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin gebruikt Bluetooth om verbinding te maken met uw slimme bril (Ray-Ban Meta of EVEN Realities G2)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Avenkin usa o Bluetooth para se conectar aos seus óculos inteligentes (Ray-Ban Meta ou EVEN Realities G2)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin использует Bluetooth для подключения к вашим умным очкам (Ray-Ban Meta или EVEN Realities G2)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin 使用 Bluetooth 连接你的智能眼镜（Ray-Ban Meta 或 EVEN Realities G2）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin 使用 Bluetooth 連接你的智慧眼鏡（Ray-Ban Meta 或 EVEN Realities G2）。"
          }
        }
      }
    },
