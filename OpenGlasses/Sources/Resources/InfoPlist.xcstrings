    "NSLocalNetworkUsageDescription" : {
      "comment" : "Info.plist NSLocalNetworkUsageDescription: the reason iOS shows when it asks for this permission.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم Avenkin شبكتك المحلية للعثور على خوادم الذكاء الاصطناعي المستضافة ذاتيًا (Ollama، LM Studio، vLLM، LocalAI) دون الحاجة إلى كتابة عنوان، ولبث الفيديو إلى خادم على شبكتك الخاصة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Avenkin uses your local network to find self-hosted AI servers (Ollama, LM Studio, vLLM, LocalAI) without typing an address, and to stream video to a server on your own network."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin usa tu red local para encontrar servidores de IA autoalojados (Ollama, LM Studio, vLLM, LocalAI) sin que tengas que escribir una dirección, y para transmitir video a un servidor en tu propia red."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin utilise votre réseau local pour trouver des serveurs d'IA auto-hébergés (Ollama, LM Studio, vLLM, LocalAI) sans que vous ayez à saisir d'adresse, et pour diffuser de la vidéo vers un serveur de votre propre réseau."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Avenkin a helyi hálózatot használja, hogy cím beírása nélkül megtalálja a saját üzemeltetésű AI-szervereket (Ollama, LM Studio, vLLM, LocalAI), és hogy videót streameljen a saját hálózatán lévő szerverre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin usa la rete locale per trovare server AI self-hosted (Ollama, LM Studio, vLLM, LocalAI) senza dover digitare un indirizzo e per trasmettere video in streaming a un server sulla tua rete."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkinは、アドレスを入力せずにセルフホスト型AIサーバ（Ollama、LM Studio、vLLM、LocalAI）を見つけたり、ご自身のネットワーク上のサーバにビデオをストリーミングしたりするために、ローカルネットワークを使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin은 주소를 입력하지 않고도 자체 호스팅 AI 서버(Ollama, LM Studio, vLLM, LocalAI)를 찾고, 사용자 네트워크의 서버로 동영상을 스트리밍하기 위해 로컬 네트워크를 사용합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin gebruikt uw lokale netwerk om zelfgehoste AI-servers (Ollama, LM Studio, vLLM, LocalAI) te vinden zonder dat u een adres hoeft in te typen, en om video te streamen naar een server op uw eigen netwerk."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Avenkin usa sua rede local para encontrar servidores de IA auto-hospedados (Ollama, LM Studio, vLLM, LocalAI) sem que você precise digitar um endereço e para transmitir vídeo para um servidor na sua própria rede."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin использует локальную сеть, чтобы находить ваши собственные серверы ИИ (Ollama, LM Studio, vLLM, LocalAI) без ввода адреса и транслировать видео на сервер в вашей сети."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin 使用你的本地网络查找自托管的 AI 服务器（Ollama、LM Studio、vLLM、LocalAI），无需输入地址，还可将视频流式传输到你自己网络上的服务器。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin 使用你的區域網路尋找自行架設的 AI 伺服器（Ollama、LM Studio、vLLM、LocalAI），不必輸入位址，還能將影片串流到你自己網路上的伺服器。"
          }
        }
      }
    },
    "NSLocationAlwaysAndWhenInUseUsageDescription" : {
      "comment" : "Info.plist NSLocationAlwaysAndWhenInUseUsageDescription: the reason iOS shows when it asks for this permission.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم Avenkin موقعك في الخلفية لتنبيهك عند وصولك إلى مكان ضبطت له تذكيرًا بالموقع أو مغادرتك له."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Avenkin uses your location in the background to alert you when you arrive at or leave a place you set a location reminder for."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin usa tu ubicación en segundo plano para avisarte cuando llegues a un lugar para el que configuraste un recordatorio por ubicación, o cuando salgas de él."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin utilise votre position en arrière-plan pour vous avertir lorsque vous arrivez à un lieu pour lequel vous avez créé un rappel de lieu, ou lorsque vous le quittez."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Avenkin a háttérben is használja a tartózkodási helyét, hogy értesítse, amikor megérkezik egy olyan helyre, amelyhez helyalapú emlékeztetőt állított be, vagy elhagyja azt."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin usa la tua posizione in background per avvisarti quando arrivi in un luogo per cui hai impostato un promemoria di posizione o quando lo lasci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkinは、位置情報リマインダーを設定した場所に到着したときや、その場所を離れたときにお知らせするため、バックグラウンドで位置情報を使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin은 위치 기반 알림을 설정한 장소에 도착하거나 그 장소를 떠날 때 알려 주기 위해 백그라운드에서 위치를 사용합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin gebruikt uw locatie op de achtergrond om u te waarschuwen wanneer u aankomt op of vertrekt van een plek waarvoor u een locatieherinnering hebt ingesteld."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Avenkin usa sua localização em segundo plano para avisar quando você chega ou sai de um lugar para o qual definiu um lembrete por localização."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin использует вашу геопозицию в фоновом режиме, чтобы уведомлять вас, когда вы прибываете в место, для которого задано напоминание по местоположению, или покидаете его."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin 在后台使用你的位置，以便在你到达或离开设有位置提醒的地点时提醒你。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin 會在背景使用你的位置，在你抵達或離開設有位置提醒的地點時通知你。"
          }
        }
      }
    },
