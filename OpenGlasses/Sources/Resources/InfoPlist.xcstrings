    "NSSpeechRecognitionUsageDescription" : {
      "comment" : "Info.plist NSSpeechRecognitionUsageDescription: the reason iOS shows when it asks for this permission.",
      "extractionState" : "extracted_with_value",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم Avenkin التعرّف على الكلام لاكتشاف كلمة التنبيه وتحويل أسئلتك الصوتية إلى نص لمساعد الذكاء الاصطناعي."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Avenkin uses speech recognition to detect the wake word and transcribe your voice questions for the AI assistant."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin usa el reconocimiento de voz para detectar la palabra de activación y transcribir tus preguntas habladas para el asistente de IA."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin utilise la reconnaissance vocale pour détecter le mot d'activation et transcrire vos questions vocales pour l'assistant IA."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az Avenkin beszédfelismeréssel észleli az ébresztő szót, és leírja a szóban feltett kérdéseit az AI-asszisztens számára."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin usa il riconoscimento vocale per rilevare la parola di attivazione e trascrivere le domande che fai a voce all'assistente AI."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkinは、ウェイクワードを検出し、AIアシスタントへの音声での質問を書き起こすために音声認識を使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin은 웨이크 워드를 감지하고 AI 어시스턴트에게 하는 음성 질문을 텍스트로 변환하기 위해 음성 인식을 사용합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin gebruikt spraakherkenning om het activeringswoord te herkennen en uw gesproken vragen voor de AI-assistent uit te schrijven."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Avenkin usa o reconhecimento de fala para detectar a palavra de ativação e transcrever suas perguntas faladas para o assistente de IA."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin использует распознавание речи, чтобы обнаруживать слово активации и расшифровывать ваши голосовые вопросы для ИИ-ассистента."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Avenkin 使用语音识别来检测唤醒词，并为 AI 助手转写你的语音提问。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
