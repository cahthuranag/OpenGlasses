          "stringUnit" : {
            "state" : "translated",
            "value" : "A vezérlők a rácson maradnak, és csak újrarendelhetők."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "I controlli rimangono sulla griglia e possono solo essere riordinati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "コントロールはグリッドにとどまり、並べ替えのみ可能です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "컨트롤은 그리드에 유지되며 재정렬만 가능합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Besturingen blijven op het raster en kunnen alleen opnieuw worden geordend."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Os controles permanecem na grade e só podem ser reordenados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Элементы управления остаются в сетке, их можно только переупорядочить."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "控件保留在网格中，只能重新排序。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "控制保持在網格上，只能重新排序。"
          }
        }
      }
    },
