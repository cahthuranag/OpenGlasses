    "Chats and questions from this day that weren't part of a job. Turn off to send jobs only." : {
      "comment" : "Text for a toggle that lets the user decide whether to include conversations from other days.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الدردشات والأسئلة من هذا اليوم والتي لم تكن جزءًا من الوظيفة. قم بإيقاف التشغيل لإرسال المهام فقط."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chats y preguntas de este día que no fueron parte de un trabajo. Desactívalo para enviar solo trabajos."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Discussions et questions de cette journée qui ne faisaient pas partie d'un travail. Désactivez pour envoyer uniquement des travaux."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Csevegés és kérdés a mai napról, amelyek nem a munka részét képezték. Csak a feladatok küldéséhez kapcsolja ki."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiacchiere e domande di questa giornata che non facevano parte di un lavoro. Disattiva per inviare solo lavori."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "この日のチャットや質問（業務の一部でなかったもの）。オンにすると業務のみ送信します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "오늘의 업무와 관련이 없는 채팅과 질문입니다. 작업만 보내려면 끄세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chats en vragen van deze dag die niet bij een baan hoorden. Schakel dit uit om alleen taken te verzenden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bate-papos e dúvidas deste dia que não faziam parte de um trabalho. Desative para enviar apenas trabalhos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Чаты и вопросы за этот день, не относящиеся к заданию. Отключите, чтобы отправлять только задания."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当天的聊天和问题，这些不属于工作内容。关闭以仅发送工作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當天的聊天與問題，並非工作的一部分。關閉以僅傳送工作。"
          }
        }
      }
    },
