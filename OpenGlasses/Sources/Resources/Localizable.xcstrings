          }
        }
      }
    },
    "The agent will ask you questions to learn about you and customize its personality. Say \"%@\" to begin." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سيطرح الوكيل أسئلة للتعرف عليك وتخصيص شخصيته. قل \"%1$@\" للبدء."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El agente te hará preguntas para conocerte y personalizar su personalidad. Di “%@” para empezar."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'agent vous posera des questions pour apprendre à vous connaître et personnaliser sa personnalité. Dites \"%1$@\" pour commencer."
