          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Montre tous les travaux et tout ce qu'il reste à faire."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Megmutat minden munkát és mindent, amit még el kell végezni."
