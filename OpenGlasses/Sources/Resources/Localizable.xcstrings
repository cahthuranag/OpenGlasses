            "value" : "التعليمات التي يعمل بها الذكاء الاصطناعي وفق الجدول. اكتبها كما لو كنت تتحدث إلى المساعد."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La instrucción que la IA ejecuta según lo programado. Escríbela como si le hablaras al asistente."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'instruction selon laquelle l'IA fonctionne selon le calendrier. Écris-la comme si tu parlais à l'assistant."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az utasítás, amit az AI az ütemterv szerint végrehajt. Írd úgy, mintha az asszisztenssel beszélnél."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'istruzione che l'IA esegue nei tempi previsti. Scrivilo come se stessi parlando con l'assistente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AIはスケジュールに従ってこの指示を実行します。アシスタントに話しかけるように書いてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
