    "Subscription renews automatically. Cancel anytime in Settings → Apple ID → Subscriptions." : {
      "comment" : "A description of the terms of a subscription.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتجدد الاشتراك تلقائياً. يمكنك الإلغاء في أي وقت من الإعدادات → معرف Apple → الاشتراكات."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La suscripción se renueva automáticamente. Cancela en cualquier momento en Configuración → Apple ID → Suscripciones."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'abonnement se renouvelle automatiquement. Annulez à tout moment dans Réglages → identifiant Apple → Abonnements."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az előfizetés automatikusan megújul. Bármikor lemondható a Beállítások → Apple ID → Előfizetések menüpontban."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'abbonamento si rinnova automaticamente. Annulla in qualsiasi momento in Impostazioni → ID Apple → Abbonamenti."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サブスクリプションは自動的に更新されます。設定 → Apple ID → サブスクリプションでいつでもキャンセルできます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "구독은 자동으로 갱신됩니다. 설정 → Apple ID → 구독에서 언제든지 취소할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
