    },
    "Put what matters next here instead of an animation." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ضع ما يهم بعد ذلك هنا بدلاً من الرسوم المتحركة."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pon aquí lo que sigue en importancia en lugar de una animación."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mettez ce qui compte ensuite ici au lieu d'une animation."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Animáció helyett tedd ide, ami számít."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Metti qui ciò che conta dopo invece di un'animazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "アニメーションの代わりに、次に重要なものをここに置きます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "애니메이션 대신 중요한 것을 여기에 넣으세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet hier in plaats van een animatie wat er hierna belangrijk is."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloque o que importa a seguir aqui em vez de uma animação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Разместите здесь то, что важно дальше, вместо анимации."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请将重要内容放在这里，而不是动画。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將接下來重要的內容放在這裡，而不是動畫。"
          }
        }
      }
    },
    "Puts the bar back to the shipped order with nothing hidden. Your speed-dial actions are untouched." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعيد الشريط إلى الطلب المشحون دون إخفاء أي شيء. إجراءات الاتصال السريع الخاصة بك تبقى بدون تغيير."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Devuelve la barra al orden de fábrica, sin nada oculto. Tus acciones de marcación rápida no se tocan."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remet la barre dans l'ordre expédié sans rien cacher. Vos actions de numérotation rapide ne sont pas affectées."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Visszahelyezi a rudat a kiszállított rendelésre, semmi rejtett nélkül. A gyorstárcsázási műveletei érintetlenek."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riporta la barra all'ordine spedito senza nulla nascosto. Le tue azioni di chiamata rapida rimangono intatte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "バーを出荷時の順序に戻し、何も隠さないようにします。スピードダイヤルの操作はそのままです。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "아무것도 숨기지 않고 선적된 주문으로 바를 되돌립니다. 단축 다이얼 작업은 그대로 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zet de balk terug naar de verzonden volgorde zonder iets te verbergen. Je snelkies-acties blijven onaangetast."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloca a barra de volta no pedido enviado sem nada oculto. Suas ações de discagem rápida permanecem intactas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Возвращает панель к исходному порядку поставки, ничего не скрывая. Ваши действия быстрого набора не затрагиваются."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将工具栏恢复到出货时的顺序，没有隐藏内容。您的快速拨号操作保持不变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "將工具列恢復到出廠順序，沒有任何隱藏內容。你的快速撥號動作未受影響。"
          }
        }
      }
    },
    "Puts the bar back to the shipped order. Your actions are kept." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعيد الشريط إلى الطلب المشحون. يتم الاحتفاظ بإجراءاتك."
