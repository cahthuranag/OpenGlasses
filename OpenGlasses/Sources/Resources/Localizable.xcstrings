    },
    "Works best with the signer 1–2 m away, facing the camera, at a camera frame rate of 15 fps or higher (Settings › Look & Feel › Camera)." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعمل بشكل أفضل مع الموقع 1–2 م بعيدًا عن الكاميرا، مواجهًا لها، بمعدل إطارات كاميرا 15 إطارًا في الثانية أو أكثر (الإعدادات › المظهر والشعور › الكاميرا)."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funciona mejor con la persona que seña a 1 o 2 m de distancia, de frente a la cámara, con una velocidad de cuadros de la cámara de 15 fps o más (Configuración › Aspecto › Cámara)."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fonctionne mieux lorsque le signataire est à 1–2 m de distance, face à la caméra, avec un taux de trame de la caméra de 15 ips ou plus (Réglages › Apparence › Caméra)."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legjobban működik, ha az aláíró 1–2 m-re van, a kamerával szemben, legalább 15 képkocka/másodperc sebességű kamerával (Beállítások › Megjelenés › Kamera)."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funziona meglio con il firmatario a 1-2 m di distanza, di fronte alla fotocamera, con una frequenza fotogrammi della fotocamera di 15 fps o superiore (Impostazioni › Aspetto › Fotocamera)."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "署名者がカメラに向かって1〜2 m離れた位置にいる場合、カメラのフレームレートが15 fps以上で最適に動作します（設定 › 外観と操作感 › カメラ）。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "15fps 이상의 카메라 프레임 속도에서 1~2m 떨어진 서명자가 카메라를 바라보는 상태에서 가장 잘 작동합니다(설정 › 모양 및 느낌 › 카메라)."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Werkt het beste met de ondertekenaar 1–2 m afstand, met het gezicht naar de camera, bij een cameraframerate van 15 fps of hoger (Instellingen › Uiterlijk & Gevoel › Camera)."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funciona melhor com o signatário a 1–2 m de distância, de frente para a câmera, em uma taxa de quadros da câmera de 15 fps ou mais (Configurações › Aparência › Câmera)."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Лучше всего работает, когда человек, использующий жестовый язык, находится в 1–2 м от камеры, стоит к ней лицом, а частота кадров камеры не ниже 15 fps (Настройки › Вид и стиль › Камера)."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最佳效果：手语者与摄像头保持 1–2 米距离，正对摄像头，摄像帧率为 15 fps 及以上（设置 › 外观与感受 › 相机）。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "與距離 1–2 米、面對相機的簽署者配合效果最佳，要求相機幀率達到 15 fps 或以上（設定 › 外觀與感受 › 相機）。"
          }
        }
      }
    },
    "Works with your iPhone" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يعمل مع iPhone الخاص بك"
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Funciona con tu iPhone"
          }
        },
        "fr-CA" : {
