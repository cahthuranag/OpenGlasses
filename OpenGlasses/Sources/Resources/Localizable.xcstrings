    "That code has already been used. Each code adds one phone: ask the office for a new one." : {
      "comment" : "A message displayed when the office has already used the code.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم استخدام هذا الرمز بالفعل. كل رمز يضيف هاتفًا واحدًا: اطلب من المكتب رمزًا جديدًا."
          }
