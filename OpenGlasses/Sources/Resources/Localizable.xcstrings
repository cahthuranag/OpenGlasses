    "The recognizer and its landmark extractor download once (~32 MB) and then work offline." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقوم برنامج التعرف ومستخرج العلامات التمييزية الخاص به بالتحميل مرة واحدة (~32 ميغابايت) ثم يعملان دون اتصال بالإنترنت."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El reconocedor y su extractor de puntos de referencia se descargan una vez (~32 MB) y luego funcionan sin conexión."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le reconnaisseur et son extracteur de points de repère se téléchargent une seule fois (~32 Mo) puis fonctionnent hors ligne."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A felismerő és a jellegzetesség-kivonó egyszer letölthető (~32 MB), majd offline működik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il riconoscitore e il suo estrattore di punti di riferimento vengono scaricati una volta (~32 MB) e quindi funzionano offline."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "認識器とそのランドマーク抽出器は一度ダウンロードされます（約32 MB）その後はオフラインで動作します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "인식기와 해당 랜드마크 추출기는 한 번(~32MB) 다운로드한 다음 오프라인으로 작업합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De herkenner en zijn landmark-extractor worden eenmaal gedownload (~32 MB) en werken daarna offline."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O reconhecedor e seu extrator de pontos de referência são baixados uma vez (~32 MB) e depois funcionam offline."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Распознаватель и его экстрактор ориентиров загружаются один раз (~32 МБ), а затем работают офлайн."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "识别器及其地标提取器下载一次（约32 MB）后即可离线工作。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "辨識器及其標誌提取器下載一次（約 32 MB）後即可離線工作。"
          }
        }
      }
    },
    "The recording is saved on this phone and will be prepared for the office." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
