    "%@ has replaced its admin card. Scan the new one to make this an administrator phone again." : {
      "comment" : "A message that appears in the footer of the administrator section of an administrator phone. The argument is the string “your organisation”.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قامت %1$@ باستبدال بطاقة المسؤول الخاصة بها. قم بمسح الهاتف الجديد ضوئيًا لجعل هذا الهاتف مسؤولًا مرة أخرى."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ reemplazó su tarjeta de administrador. Escanea la nueva para que este vuelva a ser un celular de administrador."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ a remplacé sa carte d'administration. Scannez la nouvelle pour en faire de nouveau un téléphone administrateur."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A %1$@ lecserélte admin kártyáját. Szkennelje be az újat, hogy ismét rendszergazdai telefon legyen."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ha sostituito la sua scheda amministratore. Scansiona quello nuovo per renderlo nuovamente un telefono amministratore."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ は管理者カードを新しいものに置き換えました。この電話を再び管理者電話にするには、新しいカードをスキャンしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@가 관리자 카드를 교체했습니다. 새 전화를 스캔하여 다시 관리자 전화로 만드세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ heeft de beheerderskaart vervangen. Scan de nieuwe om er weer een beheerderstelefoon van te maken."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ substituiu seu cartão de administração. Digitalize o novo para torná-lo um telefone de administrador novamente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@ заменила административную карту. Отсканируйте новую, чтобы снова сделать этот телефон административным."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 已更换其管理卡。扫描新手机，使其再次成为管理员电话。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 已更換其管理卡。掃描新手機，使其再次成為管理員電話。"
