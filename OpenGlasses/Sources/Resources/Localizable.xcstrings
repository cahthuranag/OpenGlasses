    "Looks something up in this manual for the open job." : {
      "comment" : "A hint for the accessibility label of the \"Ask\" button.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يبحث عن شيء ما في هذا الدليل للوظيفة المفتوحة."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Busca algo en este manual para el trabajo abierto."
          }
        },
