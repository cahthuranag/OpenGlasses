    "Your access key connects directly to your provider. We never see or store your conversations." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مفتاح الوصول الخاص بك يتصل مباشرة بمزود الخدمة الخاص بك. نحن لا نرى أو نخزن محادثاتك أبدًا."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu clave de acceso se conecta directamente con tu proveedor. Nunca vemos ni guardamos tus conversaciones."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre clé d'accès se connecte directement à votre fournisseur. Nous ne voyons ni ne stockons jamais vos conversations."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A hozzáférési kulcsod közvetlenül a szolgáltatódhoz csatlakozik. Mi soha nem látjuk vagy tároljuk a beszélgetéseidet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua chiave di accesso si collega direttamente al tuo provider. Non vediamo né memorizziamo mai le tue conversazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "あなたのアクセスキーは直接プロバイダーに接続します。私たちはあなたの会話を確認したり保存したりすることはありません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "액세스 키는 제공업체에 직접 연결됩니다. 우리는 귀하의 대화를 보거나 저장하지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je toegangssleutel verbindt direct met je provider. Wij zien of bewaren je gesprekken nooit."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sua chave de acesso se conecta diretamente ao seu provedor. Nunca vemos ou armazenamos suas conversas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваш ключ доступа подключается напрямую к вашему провайдеру. Мы никогда не видим и не храним ваши разговоры."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的访问密钥直接连接到你的服务提供商。我们从未看到或存储你的对话。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "你的存取金鑰直接連接到你的服務提供者。我們從不查看或儲存你的對話。"
          }
        }
      }
    },
    "Your administrator needs to finish setting up this phone: %@ still needs its key." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يحتاج المسؤول الخاص بك إلى إنهاء إعداد هذا الهاتف: لا يزال %1$@ بحاجة إلى مفتاحه."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu administrador necesita terminar de configurar este celular: %@ todavía necesita su clave."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre administrateur doit terminer la configuration de ce téléphone : %1$@ a toujours besoin de sa clé."
