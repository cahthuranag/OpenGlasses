    "Uses Calendar, Reminders and Weather once you turn it on." : {
      "comment" : "A description of the My Day option.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم التقويم والتذكيرات والطقس بمجرد تشغيله."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa Calendario, Recordatorios y Clima una vez que lo activas."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise Calendrier, Rappels et Météo une fois que vous l'avez activé."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Naptár, Emlékeztetők és Időjárás funkciókat használja, miután bekapcsolod."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilizza Calendario, Promemoria e Meteo una volta acceso."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オンにすると、カレンダー、リマインダー、天気を使用します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "캘린더, 미리 알림, 날씨를 켜면 사용됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruikt Agenda, Herinneringen en Weer zodra u het inschakelt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa Calendário, Lembretes e Tempo assim que você ativá-los."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Использует Календарь, Напоминания и Погоду, когда вы это включите."
