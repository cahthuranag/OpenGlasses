        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Discord는 질문을 하거나 자신이 만든 것을 공유하는 가장 빠른 방법입니다."
          }
        },
        "nl" : {
          "stringUnit" : {
