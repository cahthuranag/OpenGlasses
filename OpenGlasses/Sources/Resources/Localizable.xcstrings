    "Secure browser sharing is not implemented yet; the legacy cleartext listener is limited to Debug development builds." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مشاركة المتصفح الآمنة لم تُنفذ بعد؛ المستمع النصي القديم محدود في إصدارات التطوير Debug."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compartir de forma segura en el navegador aún no está implementado; el listener heredado de texto sin cifrar se limita a compilaciones de desarrollo Debug."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le partage sécurisé du navigateur n'est pas encore implémenté ; l'écouteur clair hérité est limité aux versions de développement Debug."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A biztonságos böngészőmegosztás még nincs megvalósítva; az örökölt cleartext figyelő a Debug fejlesztési buildekre korlátozódik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La condivisione sicura del browser non è ancora stata implementata; il listener legacy in chiaro è limitato alle build di sviluppo di debug."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安全なブラウザ共有はまだ実装されていません。レガシーの平文リスナーはデバッグ開発ビルドに限定されています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보안 브라우저 공유는 아직 구현되지 않았습니다. 레거시 일반 텍스트 리스너는 디버그 개발 빌드로 제한됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Veilige browserdeling is nog niet geïmplementeerd; de legacy cleartext-luisteraar is beperkt tot Debug-ontwikkelingsbuilds."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O compartilhamento seguro do navegador ainda não foi implementado; o ouvinte de texto não criptografado herdado é limitado a compilações de desenvolvimento de depuração."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Безопасный доступ через браузер пока не реализован; устаревший прослушиватель без шифрования доступен только в отладочных сборках для разработки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安全浏览器共享尚未实现；传统明文监听器仅限于调试开发版本。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "安全瀏覽器共享尚未實現；舊版明文監聽器僅限於調試開發版。"
          }
        }
      }
    },
