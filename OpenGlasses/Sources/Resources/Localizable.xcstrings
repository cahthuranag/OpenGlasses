    "Requests are classified by complexity and routed to the assigned model. Memory and conversation context are always preserved." : {
      "comment" : "A description of the auto model routing feature.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم تصنيف الطلبات حسب التعقيد وتوجيهها إلى النموذج المخصص. يتم دائمًا الحفاظ على الذاكرة وسياق المحادثة."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las solicitudes se clasifican por complejidad y se enrutan al modelo asignado. La memoria y el contexto de la conversación siempre se conservan."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les demandes sont classées par complexité et acheminées vers le modèle assigné. La mémoire et le contexte de la conversation sont toujours préservés."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kérelmeket összetettség szerint osztályozzák, és a hozzárendelt modellhez irányítják. Az emlékezet és a beszélgetés kontextusa mindig megmarad."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le richieste vengono classificate per complessità e instradate al modello assegnato. La memoria e il contesto della conversazione sono sempre preservati."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リクエストは複雑さによって分類され、割り当てられたモデルにルーティングされます。メモリと会話コンテキストは常に保持されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "요청은 복잡성에 따라 분류되어 할당된 모델로 라우팅됩니다. 메모리와 대화 내용은 항상 보존됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verzoeken worden ingedeeld op complexiteit en doorgestuurd naar het toegewezen model. Geheugen en gesprekcontext worden altijd behouden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As solicitações são classificadas por complexidade e roteadas para o modelo atribuído. A memória e o contexto da conversa são sempre preservados."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запросы классифицируются по сложности и направляются к назначенной модели. Память и контекст разговора всегда сохраняются."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请求根据复杂性进行分类，并路由到分配的模型。记忆和对话上下文总是被保留。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請求按複雜性分類，並路由到分配的模型。記憶和對話上下文始終被保留。"
          }
        }
      }
    },
    "Requests authenticate with OAuth on your GCP project — no API key." : {
