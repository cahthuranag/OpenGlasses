        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "추천 이유와 그에 대해 기록된 내용을 보려면 두 번 탭하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dubbeltik om te zien waarom het werd aanbevolen en wat er tegen werd opgenomen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque duas vezes para saber por que foi recomendado e o que foi registrado nele."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Дважды нажмите, чтобы узнать, почему это было рекомендовано и что было зафиксировано."
