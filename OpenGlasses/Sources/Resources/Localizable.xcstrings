    "In EU and EEA App Store regions, face recognition will stop being available on 2 December 2027." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "في مناطق متجر التطبيقات في الاتحاد الأوروبي والمنطقة الاقتصادية الأوروبية، سيتوقف التعرف على الوجه عن العمل في 2 ديسمبر 2027."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
