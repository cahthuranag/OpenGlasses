        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo o que foi dito hoje até agora, para apoio. Você leu antes de ser enviado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Всё сказанное сегодня — для поддержки. Вы увидите это перед отправкой."
