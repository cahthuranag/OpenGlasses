    "Choose what Siri can run. Say \"Run <action> on Avenkin\" — or create your own actions below." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اختر ما يمكن تشغيله على Siri. قل \"تشغيل <action> على Avenkin\" - أو قم بإنشاء الإجراءات الخاصة بك أدناه."
          }
        },
        "es-MX" : {
          "stringUnit" : {
