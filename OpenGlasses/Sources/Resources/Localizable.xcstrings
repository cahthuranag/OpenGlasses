      }
    },
    "Tap a manual to open it, or Ask to look something up in it for this job." : {
      "comment" : "A description of the action to take when a user taps a manual.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط على دليل لفتحه، أو اسأل للبحث عن شيء فيه لهذا العمل."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca un manual para abrirlo, o Preguntar para buscar algo en él para este trabajo."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez sur un manuel pour l’ouvrir, ou demandez de rechercher quelque chose dedans pour ce travail."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Érintsd meg a kézikönyvet az megnyitásához, vagy Kérdezd meg, hogy keressen benne valamit ehhez a munkához."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca un manuale per aprirlo oppure chiedi di cercare qualcosa al suo interno per questo lavoro."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マニュアルをタップして開くか、このジョブで何かを調べるには「Ask」を使用してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "매뉴얼을 눌러 열거나 이 작업에 대한 내용을 찾아보라고 요청하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op een handleiding om deze te openen, of Vraag om iets op te zoeken in die handleiding voor deze taak."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em um manual para abri-lo ou peça para procurar algo nele para este trabalho."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите на руководство, чтобы открыть его, или «Спросить», чтобы найти в нём что-то для этого задания."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击手册以打开，或选择查询本工作相关内容。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "點擊手冊以打開，或請求在這個工作中查找相關內容。"
          }
        }
      }
    },
    "Tap a manual to open it. Ask a manual a question during a job on its vault." : {
      "comment" : "A description of the manuals section.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط على دليل لفتحه. اسأل الدليل سؤالاً أثناء العمل في خزانه."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca un manual para abrirlo. Hazle una pregunta a un manual durante un trabajo con su bóveda."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez sur un manuel pour l’ouvrir. Posez une question à un manuel pendant un travail sur son coffre."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Érintsd meg a kézikönyvet az megnyitásához. Tegyél fel kérdést a kézikönyvnek a munka során a tárában."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tocca un manuale per aprirlo. Fai una domanda a un manuale durante un lavoro sul suo caveau."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マニュアルをタップして開きます。作業中に保管庫のマニュアルに質問します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "설명서를 탭하여 엽니다. Vault에서 작업하는 동안 매뉴얼에 질문을 해보세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tik op een handleiding om deze te openen. Stel een vraag aan een handleiding tijdens een taak in zijn kluis."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toque em um manual para abri-lo. Faça uma pergunta a um manual durante um trabalho em seu cofre."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Нажмите на руководство, чтобы открыть его. Задать вопрос по руководству можно во время задания с его хранилищем."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "点击手册以打开。在进行任务时，可以在其保险库中向手册提问。"
