    "Everything said today so far, this job included, for support. You see it before anything is sent." : {
      "comment" : "A hint for the button that sends the day's conversations for support.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
