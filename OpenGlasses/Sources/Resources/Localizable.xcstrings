    "Allows installing unsigned packs while building your own. Unsigned packs are labeled on their row. The catalog's own signature is always enforced." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يسمح بتثبيت الحزم غير الموقعة أثناء بناء الحزم الخاصة بك. يتم وضع علامة على الحزم غير الموقعة في صفها. يتم فرض التوقيع الخاص بالكتالوج دائمًا."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite instalar paquetes sin firma mientras creas los tuyos. Los paquetes sin firma se indican en su fila. La firma del propio catálogo siempre se exige."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permet d'installer des packs non signés lors de la création des vôtres. Les packs non signés sont étiquetés sur leur ligne. La signature du catalogue est toujours appliquée."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lehetővé teszi aláíratlan csomagok telepítését saját építés közben. Az aláíratlan csomagok a sorukon vannak felcímkézve. A katalógus saját aláírása mindig érvényesül."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consente l'installazione di pacchetti non firmati durante la creazione dei propri. I pacchetti non firmati sono etichettati sulla loro riga. Fa sempre fede la firma propria del catalogo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分自身でビルドする際に署名されていないパックのインストールを許可します。署名されていないパックはその行にラベルが付けられています。カタログ自体の署名は常に適用されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자신만의 팩을 만드는 동안 서명되지 않은 팩을 설치할 수 있습니다. 서명되지 않은 팩은 해당 행에 라벨이 붙어 있습니다. 카탈로그 자체 서명은 항상 적용됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maakt het mogelijk om niet-ondertekende pakketten te installeren terwijl je je eigen pakketten bouwt. Niet-ondertekende pakketten zijn op hun rij gelabeld. De eigen handtekening van de catalogus wordt altijd gehandhaafd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Permite instalar pacotes não assinados enquanto cria o seu próprio. Pacotes não assinados são rotulados em suas linhas. A assinatura do próprio catálogo é sempre aplicada."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Позволяет устанавливать неподписанные наборы при создании своего собственного. Неподписанные наборы помечаются в своей строке. Подпись самого каталога проверяется всегда."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允许在自建过程中安装未签名包。未签名包会在其行中标注。目录自身的签名始终强制执行。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "允許在建立自己的套件時安裝未簽名套件。未簽名套件會在其行上標示。目錄自身的簽名始終會被強制執行。"
          }
        }
      }
    },
