    "Realtime authentication or configuration was rejected. Check the saved model settings." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "رُفض التحقق من الهوية أو إعداد الوقت الفعلي. تحقق من إعدادات النموذج المحفوظ."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se rechazó la autenticación o configuración en tiempo real. Revisa la configuración del modelo guardado."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L’authentification ou la configuration en temps réel a été refusée. Vérifiez les réglages du modèle enregistré."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A valós idejű hitelesítést vagy beállítást elutasították. Ellenőrizze a mentett modell beállításait."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Autenticazione o configurazione in tempo reale rifiutata. Controlla le impostazioni del modello salvato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "リアルタイムの認証または設定が拒否されました。保存したモデル設定を確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "실시간 인증 또는 구성이 거부되었습니다. 저장된 모델 설정을 확인하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
