        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A chave de ativação fornecida pela sua empresa ou o código de licença completo. Procurar uma chave de ativação requer a Internet uma vez."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ключ активации, который вам дала компания, или полный код лицензии. Для проверки ключа активации один раз потребуется интернет."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "您公司提供给您的激活密钥，或完整的许可证代码。查找激活密钥只需一次联网。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
