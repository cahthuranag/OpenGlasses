          "stringUnit" : {
            "state" : "translated",
            "value" : "摘要已關閉。"
          }
        }
      }
    },
    "The Discord is the fastest way to ask a question or share what you've built." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "دي سكورد هو أسرع وسيلة لطرح سؤال أو مشاركة ما قمت ببنائه."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Discord es la forma más rápida de hacer una pregunta o compartir lo que has creado."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Discord est le moyen le plus rapide pour poser une question ou partager ce que vous avez créé."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Discord a leggyorsabb módja annak, hogy kérdést tegyél fel, vagy megoszd, amit építettél."
          }
