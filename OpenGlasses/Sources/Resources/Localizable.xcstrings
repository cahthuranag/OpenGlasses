        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez egy AI-becslés, amely egyetlen kamera nézetéből készült. Nem mérés, ellenőrzés vagy tanúsítás, és minden, ami ezen a nézeten kívül van, nem lett értékelve."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questa è una stima AI prodotta da una singola visualizzazione della telecamera. Non è una misurazione, un'ispezione o una certificazione e qualsiasi cosa al di fuori di tale visione non è stata valutata."
          }
        },
        "ja" : {
          "stringUnit" : {
