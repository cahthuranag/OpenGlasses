            "value" : "이러한 언어는 앱과 함께 번들로 제공되며 항상 사용할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deze talen worden meegeleverd met de app en zijn altijd beschikbaar."
          }
        },
        "pt-BR" : {
