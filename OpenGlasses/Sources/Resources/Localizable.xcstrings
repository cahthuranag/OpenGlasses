    "Apple Music or a Home Assistant speaker — “play Rumours on the kitchen speaker.”" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Music أو مكبر صوت Home Assistant - \"قم بتشغيل Rumors على مكبر صوت المطبخ.\""
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Music o una bocina de Home Assistant: “pon Rumours en la bocina de la cocina”."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Music ou un haut-parleur Home Assistant — « jouer Rumours sur le haut-parleur de la cuisine. »"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Music vagy egy Home Assistant hangszóró – „játssza le a pletykákat a konyhai hangszórón”."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apple Music o un altoparlante Home Assistant: \"riproduci Rumors sull'altoparlante della cucina\"."
          }
        },
        "ja" : {
          "stringUnit" : {
