          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A gravação fica salva neste telefone e será preparada para o escritório."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Запись сохранена на этом телефоне и будет подготовлена для офиса."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
