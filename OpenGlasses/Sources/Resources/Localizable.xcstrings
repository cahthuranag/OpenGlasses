    "Voice control is off in this mode. Use the buttons on this screen to start, pause or stop reminders." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التحكم الصوتي مغلق في هذا الوضع. استخدم الأزرار على هذه الشاشة للبدء أو الإيقاف المؤقت أو إيقاف التذكيرات."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El control por voz está desactivado en este modo. Usa los botones de esta pantalla para iniciar, pausar o detener los recordatorios."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le contrôle vocal est désactivé dans ce mode. Utilisez les boutons sur cet écran pour démarrer, mettre en pause ou arrêter les rappels."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A hangvezérlés ebben a módban ki van kapcsolva. Használd a gombokat ezen a képernyőn, hogy elindítsd, szüneteltesd vagy leállítsd az emlékeztetőket."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "In questa modalità il controllo vocale è disattivato. Utilizza i pulsanti in questa schermata per avviare, mettere in pausa o interrompere i promemoria."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このモードでは音声操作はオフです。この画面のボタンを使ってリマインダーを開始、停止、または一時停止してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이 모드에서는 음성 제어가 꺼집니다. 이 화면의 버튼을 사용하여 알림을 시작, 일시 중지 또는 중지할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Stem bediening is uitgeschakeld in deze modus. Gebruik de knoppen op dit scherm om herinneringen te starten, pauzeren of te stoppen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O controle de voz está desligado neste modo. Use os botões nesta tela para iniciar, pausar ou parar lembretes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Голосовое управление отключено в этом режиме. Используйте кнопки на этом экране, чтобы запускать, приостанавливать или останавливать напоминания."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此模式下语音控制已关闭。使用此屏幕上的按钮启动、暂停或停止提醒。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "此模式下語音控制已關閉。使用此畫面上的按鈕來開始、暫停或停止提醒。"
          }
        }
      }
    },
