    "Nothing is ever sent on its own. A report is built only when you ask for one, and you see every line of it before you share it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يتم إرسال أي شيء بمفرده أبدًا. يتم بناء التقرير فقط عندما تطلب واحدًا، وتسجل كل سطر منه قبل مشاركته."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
