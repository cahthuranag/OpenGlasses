    "Queries all enabled servers for available tools. Discovered tools are automatically available to the AI." : {
      "comment" : "A footer for the \"Discover Tools\" button in the MCPServersView.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستعلم عن جميع الخوادم المفعلة عن الأدوات المتاحة. الأدوات المكتشفة تكون متاحة تلقائيًا للذكاء الاصطناعي."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta a todos los servidores activados qué herramientas tienen disponibles. Las herramientas descubiertas quedan disponibles para la IA automáticamente."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interroge tous les serveurs activés pour les outils disponibles. Les outils découverts sont automatiquement accessibles à l'IA."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Lekérdezi az összes engedélyezett kiszolgálót az elérhető eszközökért. A felfedezett eszközök automatikusan elérhetők az AI számára."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Interroga tutti i server abilitati per gli strumenti disponibili. Gli strumenti rilevati sono automaticamente disponibili per l'intelligenza artificiale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "有効なすべてのサーバーに利用可能なツールを照会します。発見されたツールは自動的にAIで利用可能になります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사용 가능한 도구에 대해 활성화된 모든 서버를 쿼리합니다. 발견된 도구는 AI가 자동으로 사용할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vraagt alle ingeschakelde servers om beschikbare tools. Ontdekte tools zijn automatisch beschikbaar voor de AI."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Consulta todos os servidores habilitados em busca de ferramentas disponíveis. As ferramentas descobertas ficam automaticamente disponíveis para a IA."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Опрашивает все включённые серверы на предмет доступных инструментов. Обнаруженные инструменты автоматически становятся доступны ИИ."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "查询所有已启用的服务器以获取可用工具。发现的工具会自动对 AI 可用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "查詢所有啟用的伺服器以獲取可用工具。被發現的工具會自動對 AI 可用。"
          }
        }
      }
    },
