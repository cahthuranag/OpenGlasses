        }
      }
    },
    "These are the same switches as under Devices & Privacy → Hardware & Privacy. Glasses without a display ignore them." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذه هي نفس المفاتيح الموجودة تحت الأجهزة والخصوصية → الأجهزة والخصوصية. النظارات التي لا تحتوي على شاشة تتجاهلها."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Son los mismos interruptores que están en Dispositivos y privacidad → Hardware y privacidad. Los lentes sin pantalla los ignoran."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il s'agit des mêmes interrupteurs que sous Appareils et confidentialité → Matériel et confidentialité. Les lunettes sans écran les ignorent."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezek ugyanazok a kapcsolók, mint az Eszközök és Adatvédelem → Hardver és Adatvédelem alatt. A kijelző nélküli szemüvegek figyelmen kívül hagyják ezeket."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Questi sono gli stessi interruttori presenti in Dispositivi e privacy → Hardware e privacy. Gli occhiali senza display li ignorano."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "これらはデバイスとプライバシー → ハードウェアとプライバシーにあるスイッチと同じです。ディスプレイのないメガネは無視します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "이는 장치 및 개인 정보 보호 → 하드웨어 및 개인 정보 보호와 동일한 스위치입니다. 디스플레이가 없는 안경은 이를 무시합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dit zijn dezelfde schakelaars als onder Apparaten & Privacy → Hardware & Privacy. Brillen zonder display negeren ze."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Essas são as mesmas opções de Dispositivos e privacidade → Hardware e privacidade. Óculos sem display os ignoram."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Это те же переключатели, что и в разделе «Устройства и конфиденциальность» → «Оборудование и конфиденциальность». Очки без дисплея их игнорируют."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "这些开关与 “设备与隐私 → 硬件与隐私” 下的一样。没有显示屏的眼镜会忽略它们。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "這些與「裝置與隱私 → 硬體與隱私」下的開關相同。沒有顯示器的眼鏡會忽略它們。"
          }
        }
      }
    },
    "These can be changed on this phone." : {
