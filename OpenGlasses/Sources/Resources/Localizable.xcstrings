    "These are requests made by the Meta Wearables SDK. Some internal SDK calls may not appear here." : {
      "comment" : "A footer description for the section of the network monitor view that lists Meta calls.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذه الطلبات مقدمة من مجموعة تطوير برامج Meta Wearables. بعض الاستدعاءات الداخلية لمجموعة التطوير قد لا تظهر هنا."
          }
        },
        "es-MX" : {
          "stringUnit" : {
