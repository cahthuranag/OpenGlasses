        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De code is verlopen voordat het kantoor deze telefoon heeft goedgekeurd. Vraag het kantoor om een nieuwe code."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O código expirou antes de o escritório aprovar este telefone. Peça ao escritório um novo código."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
