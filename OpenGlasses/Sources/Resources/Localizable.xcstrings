          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nessuno scenario guidato in questo vault: l'assistente risponde comunque dai suoi file di riferimento."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "このボールトにはガイド付きシナリオがありません — アシスタントは依然として参照ファイルから回答します。"
