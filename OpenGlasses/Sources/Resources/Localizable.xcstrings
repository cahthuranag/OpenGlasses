            "state" : "translated",
            "value" : "Le fichier"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fájl"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il dossier"
          }
        },
        "ja" : {
