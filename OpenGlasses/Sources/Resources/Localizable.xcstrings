          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Arrête et enregistre l'enregistrement, et le prépare pour l'envoyer au bureau."
          }
        },
        "hu" : {
          "stringUnit" : {
