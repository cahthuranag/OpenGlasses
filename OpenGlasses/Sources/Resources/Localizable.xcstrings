    "This is an administrator phone for %@: it shows everything, and it can show the admin card for a technician's phone to scan. Its locks still apply." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا هاتف مسؤول لـ %1$@: يعرض كل شيء، ويمكنه عرض بطاقة المسؤول لهاتف فني للمسح. ولا تزال أقفاله سارية."
          }
        },
        "es-MX" : {
          "stringUnit" : {
