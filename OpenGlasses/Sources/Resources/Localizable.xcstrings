        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tudo o que foi dito hoje até agora, nos empregos e fora deles, para apoio. Você vê isso antes de qualquer coisa ser enviada."
          }
        },
        "ru" : {
          "stringUnit" : {
