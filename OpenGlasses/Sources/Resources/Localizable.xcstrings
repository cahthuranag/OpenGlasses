    "The office approved a different phone. Nothing on this phone changed. Ask the office for a new code." : {
      "comment" : "A message displayed when the office approves a phone that's already been paired.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المكتب وافق على هاتف مختلف. لم يتغير شيء على هذا الهاتف. اطلب من المكتب رمزًا جديدًا."
          }
        },
        "es-MX" : {
