    },
    "This phone couldn't read its own office identity. Restart Avenkin and scan the code again." : {
      "comment" : "A message displayed when the phone can't read its own office identity.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذا الهاتف لم يتمكن من قراءة هويته المكتبية الخاصة به. أعد تشغيل Avenkin وامسح الرمز مرة أخرى."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Este celular no pudo leer su propia identidad de oficina. Reinicia Avenkin y escanea el código otra vez."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ce téléphone n'a pas pu lire sa propre identité de bureau. Redémarrez Avenkin et scannez le code à nouveau."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ez a telefon nem tudta elolvasni a saját irodaazonosítóját. Indítsa újra a Avenkin-t, és olvassa be újra a kódot."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
