    "Tap the record button to capture a meeting. Recordings and their transcripts appear here." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اضغط على زر التسجيل لالتقاط اجتماع. تظهر التسجيلات ونصوصها هنا."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca el botón de grabar para capturar una reunión. Las grabaciones y sus transcripciones aparecen aquí."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Touchez le bouton d'enregistrement pour capturer une réunion. Les enregistrements et leurs transcriptions apparaissent ici."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Érints meg a felvétel gombot, hogy rögzíts egy találkozót. A felvételek és azok átiratai itt jelennek meg."
          }
        },
        "it" : {
