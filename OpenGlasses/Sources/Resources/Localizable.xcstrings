    "These tools are available to the AI alongside built-in tools. Disable them in Settings → Tools." : {
      "comment" : "A footer description under the section titled \"Custom Tools\", explaining that these tools are available to the AI alongside built-in tools and that they can be disabled in the \"Tools\" section of the app settings.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "هذه الأدوات متاحة للذكاء الاصطناعي جنبًا إلى جنب مع الأدوات المدمجة. قم بتعطيلها في الإعدادات → الأدوات."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Estas herramientas están disponibles para la IA junto con las integradas. Desactívalas en Configuración → Herramientas."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
