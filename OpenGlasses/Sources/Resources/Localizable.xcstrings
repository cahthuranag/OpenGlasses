          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ zijn vergrendeld totdat u uw iPhone ontgrendelt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ ficam bloqueados até você desbloquear seu iPhone."
          }
        },
        "ru" : {
          "stringUnit" : {
