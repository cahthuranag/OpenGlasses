          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mindent, ami ma elmondott eddig, a munkahelyeken és azokon kívül, a támogatásért. Látod, mielőtt bármit elküldenének."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto detto oggi finora, nei posti di lavoro e fuori di essi, per il sostegno. Lo vedi prima che venga inviato qualsiasi cosa."
