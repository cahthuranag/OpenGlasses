    "Opens the report in %@. Nothing leaves the phone until you tap Send." : {
      "comment" : "A hint for the accessibility assistant that the button",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يفتح التقرير في %1$@. لا يخرج شيء من الهاتف حتى تضغط إرسال."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre el reporte en %@. Nada sale del celular hasta que toques Enviar."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvre le rapport dans %1$@. Rien ne quitte le téléphone tant que vous n'avez pas appuyé sur Envoyer."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Megnyitja a jelentést a %1$@ fájlban. Semmi sem hagyja el a telefont, amíg meg nem koppint a Küldés elemre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Apre il report in %1$@. Niente lascia il telefono finché non tocchi Invia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@でレポートを開きます。送信をタップするまでは何も電話から出ません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@에서 보고서를 엽니다. 보내기를 탭하기 전까지는 아무것도 전화기에서 나가지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opent het rapport in %1$@. Niets verlaat de telefoon totdat u op Verzenden tikt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre o relatório em %1$@. Nada sai do telefone até você tocar em Enviar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открывает отчёт в %@. Ничего не покидает телефон, пока вы не нажмёте «Отправить»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
