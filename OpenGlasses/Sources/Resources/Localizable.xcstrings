          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Останавливает и сохраняет запись и готовит её к отправке в офис."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
