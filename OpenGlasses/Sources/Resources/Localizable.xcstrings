    "Fallback keeps a turn alive across model limits; narration keeps you informed when it happens." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التحويل الاحتياطي يحافظ على دورة مستمرة عبر حدود النموذج؛ السرد يبقيك على اطلاع عند حدوث ذلك."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El respaldo mantiene vivo un turno cuando se alcanzan los límites del modelo; la narración te avisa cuando ocurre."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La solution de repli maintient un tour actif au-delà des limites du modèle ; la narration vous informe lorsque cela se produit."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A visszaesés életben tartja a fordulatot a modell határain túllépve; A narráció tájékoztatja Önt, amikor ez megtörténik."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il fallback mantiene viva una svolta oltre i limiti del modello; la narrazione ti tiene informato quando accade."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "フォールバックはモデルの制限を超えてターンを維持します。ナレーションは発生時に通知します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fallback은 모델 제한을 넘어서도 회전을 유지합니다. 내레이션을 통해 상황이 발생하면 계속 알려줍니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fallback houdt een bocht levend over de modelgrenzen heen; De vertelling houdt u op de hoogte wanneer het gebeurt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fallback mantém uma curva viva além dos limites do modelo; a narração mantém você informado quando isso acontece."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Резервный вариант поддерживает ход диалога при ограничениях модели; озвучивание сообщает вам, когда это происходит."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "备用方案在模型限制内保持对话进行；讲述功能会在发生时通知您。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "後備方案可在模型限制內保持回合活躍；敘述會在發生時提醒您。"
          }
        }
      }
    },
