          }
        }
      }
    },
    "A short label to pick this prompt from the list — e.g. \"Concise\", \"Coding helper\", \"British butler\"." : {
      "comment" : "A description of the prompt field.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تسمية قصيرة لاختيار هذه المطالبة من القائمة - على سبيل المثال. \"موجز\"، \"مساعد الترميز\"، \"الخادم الشخصي البريطاني\"."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Una etiqueta corta para elegir este prompt de la lista; por ejemplo, “Conciso”, “Ayudante de programación”, “Mayordomo británico”."
