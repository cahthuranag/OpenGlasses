    "Calendar includes Apple, Outlook, Microsoft 365, and other accounts that are available in the iPhone Calendar app. My Day does not connect directly to the Outlook app." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتضمن التقويم Apple وOutlook وMicrosoft 365 والحسابات الأخرى المتوفرة في تطبيق iPhone Calendar. لا يتصل My Day مباشرةً بتطبيق Outlook."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calendario incluye cuentas de Apple, Outlook, Microsoft 365 y otras que estén disponibles en la app Calendario del iPhone. Mi día no se conecta directamente con la app Outlook."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le calendrier inclut Apple, Outlook, Microsoft 365 et d'autres comptes disponibles dans l'application Calendrier iPhone. Ma journée ne se connecte pas directement à l'application Outlook."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A naptár tartalmazza az Apple, az Outlook, a Microsoft 365 és más fiókokat, amelyek elérhetők a iPhone Calendar alkalmazásban. A My Day nem csatlakozik közvetlenül az Outlook alkalmazáshoz."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Calendario include Apple, Outlook, Microsoft 365 e altri account disponibili nell'app Calendario iPhone. My Day non si connette direttamente all'app Outlook."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "カレンダーには、Apple、Outlook、Microsoft 365、その他iPhoneカレンダーアプリで利用可能なアカウントが含まれます。「マイデイ」はOutlookアプリとは直接接続しません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "캘린더에는 Apple, Outlook, Microsoft 365 및 iPhone 캘린더 앱에서 사용할 수 있는 기타 계정이 포함됩니다. My Day는 Outlook 앱에 직접 연결되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Agenda omvat Apple-, Outlook-, Microsoft 365- en andere accounts die beschikbaar zijn in de iPhone Agenda-app. My Day maakt geen directe verbinding met de Outlook-app."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Calendário inclui Apple, Outlook, Microsoft 365 e outras contas disponíveis no aplicativo Calendário iPhone. My Day não se conecta diretamente ao aplicativo Outlook."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Календарь» включает учётные записи Apple, Outlook, Microsoft 365 и другие, доступные в приложении iPhone «Календарь». «Мой день» не подключается напрямую к приложению Outlook."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "日历包括 Apple、Outlook、Microsoft 365 及 iPhone 日历应用中可用的其他账户。我的一天不会直接连接到 Outlook 应用。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "行事曆包括 Apple、Outlook、Microsoft 365 及 iPhone 行事曆應用程式中可用的其他帳號。我的一天不會直接連接到 Outlook 應用程式。"
          }
        }
      }
    },
    "Call emergency services. This does not replace a trained first aider." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "اتصل بخدمات الطوارئ. هذا لا يحل محل الإسعافات الأولية المدربة."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Llama a los servicios de emergencia. Esto no sustituye a una persona capacitada en primeros auxilios."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appeler les services d'urgence. Cela ne remplace pas un secouriste formé."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hívja a segélyszolgálatot. Ez nem helyettesíti a képzett elsősegélynyújtót."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chiama i servizi di emergenza. Questo non sostituisce un soccorritore addestrato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "緊急サービスに通報します。これは訓練を受けた応急処置者の代わりにはなりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "응급 서비스에 전화하세요. 이는 훈련받은 응급처치자를 대체할 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bel de hulpdiensten. Dit vervangt geen getrainde EHBO-er."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ligue para os serviços de emergência. Isso não substitui um socorrista treinado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вызовите экстренные службы. Это не заменяет квалифицированного специалиста по первой помощи."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "拨打紧急服务电话。这不能替代经过培训的急救员。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "撥打緊急服務電話。這不能取代受過訓練的急救人員。"
          }
        }
      }
    },
