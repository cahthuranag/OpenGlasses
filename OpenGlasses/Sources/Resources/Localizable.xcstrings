    "Use wss:// for a public Realtime server. Unencrypted ws:// is only supported on your local network." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "استخدم wss:// لخادم وقت فعلي عام. يُدعم ws:// غير المشفّر على شبكتك المحلية فقط."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa wss:// para un servidor público en tiempo real. El protocolo ws:// sin cifrar solo se admite en tu red local."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisez wss:// pour un serveur public en temps réel. Le protocole ws:// non chiffré est pris en charge seulement sur votre réseau local."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nyilvános valós idejű kiszolgálóhoz használjon wss:// protokollt. A titkosítatlan ws:// csak a helyi hálózaton támogatott."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa wss:// per un server pubblico in tempo reale. Il protocollo ws:// non crittografato è supportato solo sulla rete locale."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "公開リアルタイムサーバーには wss:// を使ってください。暗号化されない ws:// はローカルネットワークでのみ対応しています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공개 실시간 서버에는 wss://를 사용하세요. 암호화되지 않은 ws://는 로컬 네트워크에서만 지원됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruik wss:// voor een publieke realtime server. Onversleutelde ws:// wordt alleen op je lokale netwerk ondersteund."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Use wss:// para um servidor público em tempo real. O ws:// sem criptografia só é compatível com sua rede local."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Для публичного сервера реального времени используйте wss://. Незашифрованный ws:// поддерживается только в локальной сети."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "公共实时服务器请使用 wss://。未加密的 ws:// 仅支持本地网络。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "公開即時伺服器請使用 wss://。未加密的 ws:// 僅支援區域網路。"
          }
        }
      }
    },
    "Used for new jobs. An active job keeps its original vault until you finish it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم للوظائف الجديدة. تبقي الوظيفة النشطة خزنتها الأصلية حتى تنتهي منها."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa para los trabajos nuevos. Un trabajo activo conserva su bóveda original hasta que lo terminas."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisé pour de nouveaux travaux. Un travail actif conserve son coffre original jusqu'à ce que vous le terminiez."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Új feladatokhoz használatos. Az aktív feladat megőrzi az eredeti tárolóját, amíg be nem fejezed."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilizzato per nuovi lavori. Un lavoro attivo mantiene il suo deposito originale finché non lo finisci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "新しいジョブ用に使用。アクティブなジョブは、完了するまで元のボールトを保持します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "새로운 직업에 사용됩니다. 활성 작업은 사용자가 완료할 때까지 원래 저장소를 유지합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wordt gebruikt voor nieuwe taken. Een actieve taak behoudt zijn oorspronkelijke kluis totdat u deze voltooit."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usado para novos trabalhos. Um trabalho ativo mantém seu cofre original até que você o termine."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используется для новых заданий. Активное задание сохраняет своё исходное хранилище, пока вы его не завершите."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用于新工作。活动工作在完成之前保持其原始保险库。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "用於新工作。一個進行中的工作會保留其原始保險庫，直到您完成它。"
          }
        }
      }
    },
    "Used when ElevenLabs is unavailable or quota is exhausted. Download more voices in iOS Settings → Accessibility → Spoken Content → Voices." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم عندما يكون ElevenLabs غير متاح أو تم استنفاد الحصة. قم بتنزيل المزيد من الأصوات في إعدادات iOS → إمكانية الوصول → المحتوى المنطوق → الأصوات."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se usa cuando ElevenLabs no está disponible o se agotó la cuota. Descarga más voces en Configuración de iOS → Accesibilidad → Contenido leído → Voces."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilisé lorsque ElevenLabs n'est pas disponible ou que le quota est épuisé. Téléchargez plus de voix dans iOS Réglages → Accessibilité → Contenu parlé → Voix."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abban az esetben használatos, ha a ElevenLabs nem elérhető vagy a kvóta elfogyott. Tölts le több hangot a iOS Beállítások → Kisegítő lehetőségek → Beszélt tartalom → Hangok menüpontban."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilizzato quando ElevenLabs non è disponibile o la quota è esaurita. Scarica più voci in iOS Impostazioni → Accessibilità → Contenuto parlato → Voci."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ElevenLabs が利用できない場合、またはクォータが使い果たされた場合に使用します。iOS 設定 → アクセシビリティ → 音声コンテンツ → ボイスから、さらに音声をダウンロードしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ElevenLabs를 사용할 수 없거나 할당량이 소진된 경우에 사용됩니다. iOS 설정 → 접근성 → 음성 콘텐츠 → 음성에서 더 많은 음성을 다운로드하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Wordt gebruikt wanneer ElevenLabs niet beschikbaar is of de limiet is bereikt. Download meer stemmen in iOS Instellingen → Toegankelijkheid → Gesproken inhoud → Stemmen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usado quando ElevenLabs não está disponível ou a cota foi esgotada. Baixe mais vozes em Configurações do iOS → Acessibilidade → Conteúdo Falado → Vozes."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Используется, когда ElevenLabs недоступен или исчерпана квота. Дополнительные голоса можно загрузить в Настройках iOS → Универсальный доступ → Озвучивание контента → Голоса."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当 ElevenLabs 无法使用或配额已用尽时使用。在 iOS 设置 → 辅助功能 → 语音内容 → 语音 中下载更多语音。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當 ElevenLabs 無法使用或配額已用完時使用。請在 iOS 設定 → 輔助使用 → 語音內容 → 語音 中下載更多語音。"
          }
        }
      }
    },
