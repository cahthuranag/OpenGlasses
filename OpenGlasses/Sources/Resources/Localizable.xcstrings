    "You can still share transcripts manually via the share button or by asking the AI assistant." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لا يزال بإمكانك مشاركة النسخ يدويًا عبر زر المشاركة أو عن طريق طلب المساعدة من المساعد الذكي."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todavía puedes compartir transcripciones manualmente con el botón de compartir o pidiéndoselo al asistente de IA."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vous pouvez toujours partager les transcriptions manuellement via le bouton de partage ou en demandant à l'assistant IA."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Még mindig megoszthatod a felvételeket manuálisan a megosztás gomb segítségével vagy az AI asszisztens megkérdezésével."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puoi comunque condividere le trascrizioni manualmente tramite il pulsante di condivisione o chiedendo all'assistente AI."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "共有ボタンやAIアシスタントに頼むことで、手動でトランスクリプトを共有することも可能です。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공유 버튼을 사용하거나 AI 보조자에게 요청하여 수동으로 스크립트를 공유할 수 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je kunt nog steeds handmatig transcripties delen via de deelknop of door het de AI-assistent te vragen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Você ainda pode compartilhar transcrições manualmente através do botão de compartilhamento ou pedindo à assistente de IA."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Вы всё ещё можете поделиться расшифровками вручную через кнопку «Поделиться» или попросив об этом ИИ-ассистента."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
