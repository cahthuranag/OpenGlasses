        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Coloca a barra de volta no pedido enviado. Suas ações são mantidas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Возвращает панель к исходному порядку поставки. Ваши действия сохраняются."
          }
