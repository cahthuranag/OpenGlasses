    "Maps estimates only the next event with a physical location. Event locations and routes are not saved by Avenkin." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تقدر الخرائط الحدث التالي فقط بمكان فعلي. أما مواقع الأحداث والمسارات فلا يتم حفظها بواسطة Avenkin."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mapas solo calcula el siguiente evento que tenga una ubicación física. Avenkin no guarda las ubicaciones de los eventos ni las rutas."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les cartes estiment uniquement le prochain événement avec un emplacement physique. Les emplacements des événements et les itinéraires ne sont pas enregistrés par Avenkin."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Térkép csak a következő eseményt becsüli meg fizikai hellyel. Az események helyszíneit és útvonalait a Avenkin nem menti."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maps stima solo il prossimo evento con una posizione fisica. Le posizioni e i percorsi degli eventi non vengono salvati da Avenkin."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マップは物理的な場所のある次のイベントのみを推定します。イベントの場所とルートはAvenkinによって保存されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지도에서는 실제 위치가 있는 다음 이벤트만 예측합니다. 이벤트 위치와 경로는 Avenkin에 저장되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Maps schat alleen het volgende evenement met een fysieke locatie. Evenementlocaties en routes worden niet opgeslagen door Avenkin."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O Maps estima apenas o próximo evento com localização física. Locais e rotas de eventos não são salvos por Avenkin."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "«Карты» оценивают только ближайшее событие с указанным местом. Avenkin не сохраняет места событий и маршруты."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地图仅估算下一个具有实际位置的事件。事件位置和路线不会被 Avenkin 保存。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "地圖僅估算下一個具有實體位置的事件。事件位置和路線不會被Avenkin保存。"
          }
        }
      }
    },
