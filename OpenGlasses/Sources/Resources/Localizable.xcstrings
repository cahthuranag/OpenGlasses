    "Newest %lld of %lld sealed · %lld in flight. Tap a turn for its stage-by-stage breakdown." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أحدث %1$lld من %2$lld مختومة · %3$lld في الطيران. انقر على دورة لرؤية تفاصيلها مرحلة بمرحلة."
          }
        },
        "en" : {
          "stringUnit" : {
            "state" : "new",
            "value" : "Newest %1$lld of %2$lld sealed · %3$lld in flight. Tap a turn for its stage-by-stage breakdown."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los %1$lld más recientes de %2$lld sellados · %3$lld en curso. Toca un turno para ver su desglose etapa por etapa."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dernier %1$lld de %2$lld scellé · %3$lld en cours. Touchez un tour pour son analyse étape par étape."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$lld legújabb %1$lld lezárása · %3$lld repülés közben. Érintse meg a kanyart a szakaszonkénti lebontásért."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il più recente %1$lld di %2$lld sigillato · %3$lld in volo. Tocca una svolta per visualizzarne la suddivisione fase per fase."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最新の%1$lldが%2$lldに封印されています· %3$lldが進行中です。ステージごとの内訳を見るにはタップしてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%2$lld의 최신 %1$lld 밀봉 · %3$lld 비행 중. 단계별 분석을 보려면 차례를 탭하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Nieuwste %1$lld van %2$lld verzegeld · %3$lld tijdens de vlucht. Tik op een beurt voor een uitsplitsing per fase."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O mais novo %1$lld de %2$lld selado · %3$lld em vôo. Toque em uma curva para ver seu detalhamento etapa por etapa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Новейшие %1$lld из %2$lld зафиксированы · %3$lld в процессе. Нажмите на реплику для пошаговой разбивки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最新的 %1$lld 在 %2$lld 密封 · %3$lld 正在进行中。点击转动查看阶段性细分。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "最新 %1$lld 的 %2$lld 已封存 · %3$lld 正在進行中。點擊一個回合查看其逐步分解。"
          }
        }
      }
