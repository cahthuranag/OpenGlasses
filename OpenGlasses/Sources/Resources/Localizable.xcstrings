        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "将工具栏恢复到出货时的顺序。您的操作保持不变。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
