    "Gateways" : {
      "comment" : "A heading for a list of gateways.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "البوابات"
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Puertas de enlace"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
