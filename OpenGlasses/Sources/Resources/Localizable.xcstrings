    "iOS only asks once, so this permission is granted in Settings now." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS يطلب مرة واحدة فقط، لذلك تم منح هذا الإذن الآن في الإعدادات."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS solo pregunta una vez, así que ahora este permiso se concede en Configuración."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS ne demande qu'une seule fois, donc cette permission est accordée maintenant dans Paramètres."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A iOS csak egyszer kérdez rá, így ez az engedély most a Beállításokban van megadva."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS lo chiede solo una volta, quindi questa autorizzazione ora viene concessa in Impostazioni."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOSは一度だけ尋ねるので、この許可は今すぐ設定で付与されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS는 한 번만 요청하므로 이제 이 권한이 설정에서 부여됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS vraagt slechts één keer, dus deze toestemming wordt nu verleend in Instellingen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS pergunta apenas uma vez, então esta permissão é concedida em Configurações agora."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS спрашивает об этом только один раз, поэтому теперь это разрешение выдаётся в «Настройках»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 只会询问一次，因此此权限现在在设置中授予。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "iOS 只會詢問一次，因此此權限現在已在設定中授予。"
          }
        }
      }
    },
