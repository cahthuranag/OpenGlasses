    "Talk the job over. Nothing goes on the record until you save it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ناقش العمل. لا يتم تسجيل شيء حتى تقوم بحفظه."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Platica cómo estuvo el trabajo. Nada queda en el registro hasta que lo guardes."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Discutez du travail. Rien n’est enregistré tant que vous ne l’avez pas sauvegardé."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Beszéld meg a munkát. Semmi sem kerül rögzítésre, amíg el nem mented."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Discuti del lavoro. Niente viene registrato finché non lo salvi."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ジョブについて話します。保存するまで記録には残りません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "그 일에 대해 이야기해 보세요. 저장하기 전까지는 아무 것도 기록에 남지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bespreek de taak. Niets wordt geregistreerd totdat je het opslaat."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Fale sobre o trabalho. Nada fica registrado até que você o salve."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Обсудите задание вслух. Ничего не попадёт в запись, пока вы её не сохраните."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "讨论工作内容。在保存之前，任何内容都不会记录。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "討論工作。未保存前不會記錄。"
          }
        }
      }
    },
