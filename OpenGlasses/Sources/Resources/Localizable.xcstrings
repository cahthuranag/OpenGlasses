    "Provider keys and connected accounts are stored securely on the device, so they survived the reinstall." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم تخزين مفاتيح المزود والحسابات المرتبطة بأمان على الجهاز، لذلك تم الحفاظ عليها بعد إعادة التثبيت."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las claves de proveedores y las cuentas conectadas se guardan de forma segura en el dispositivo, así que sobrevivieron a la reinstalación."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les clés du fournisseur et les comptes connectés sont stockés en toute sécurité sur l'appareil, donc ils ont survécu à la réinstallation."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szolgáltatói kulcsok és a csatlakoztatott fiókok biztonságosan tárolódnak az eszközön, így túlélték az újratelepítést."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le chiavi del provider e gli account connessi vengono archiviati in modo sicuro sul dispositivo, quindi sono sopravvissuti alla reinstallazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "プロバイダーキーと接続されたアカウントはデバイス上に安全に保存されるため、再インストール後も残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "공급자 키와 연결된 계정은 장치에 안전하게 저장되므로 다시 설치해도 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Provider-sleutels en gekoppelde accounts worden veilig op het apparaat opgeslagen, dus ze overleven de herinstallatie."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As chaves do provedor e as contas conectadas são armazenadas com segurança no dispositivo, portanto sobreviveram à reinstalação."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ключи провайдеров и подключённые аккаунты надёжно хранятся на устройстве, поэтому они сохранились после переустановки."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提供者密钥和连接的账户会安全地存储在设备上，因此即使重装也不会丢失。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "提供者金鑰和連接帳戶安全地存儲在裝置上，因此重裝後仍然保留。"
          }
        }
      }
    },
    "Purchase is unavailable right now. Check your connection and App Store sign-in." : {
      "comment" : "A message displayed when the purchase button is disabled.",
      "extractionState" : "stale",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "الشراء غير متاح الآن. تحقق من الاتصال الخاص بك وتسجيل الدخول إلى متجر التطبيقات."
