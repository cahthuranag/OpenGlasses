    "To change what Avenkin can read, open the Health app, then Sharing, Apps, Avenkin." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "لتغيير ما يمكن أن يقرأه Avenkin، افتح تطبيق الصحة، ثم المشاركة، التطبيقات، Avenkin."
          }
        },
        "es-MX" : {
