          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "바를 배송된 주문으로 되돌립니다. 귀하의 행동은 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
