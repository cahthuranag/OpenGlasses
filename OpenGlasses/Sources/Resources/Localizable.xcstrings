        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ezek az eszközök az AI számára a beépített eszközök mellett elérhetők. Tiltsd le őket a Beállítások → Eszközök menüpontban."
          }
        },
        "it" : {
          "stringUnit" : {
