    "Approval retains the signed identity binding. Job and manual delivery is not enabled by this step." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تحتفظ الموافقة بربط الهوية الموقعة. لم يتم تمكين المهمة والتسليم اليدوي في هذه الخطوة."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La aprobación conserva la vinculación de identidad firmada. Este paso no activa la entrega de trabajos ni de manuales."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'approbation conserve l'association d'identité signée. La livraison manuelle et le travail ne sont pas activés par cette étape."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A jóváhagyás megtartja az aláírt identitáskötést. A feladat és a kézi kézbesítés nem engedélyezett ezzel a lépéssel."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'approvazione mantiene vincolante l'identità firmata. Il lavoro e la consegna manuale non sono abilitati da questo passaggio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "承認は署名付きのIDバインディングを保持します。このステップではジョブや手動配達は有効になりません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "승인은 서명된 ID 바인딩을 유지합니다. 이 단계에서는 작업 및 수동 전달이 활성화되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Bij goedkeuring blijft de ondertekende identiteitsbinding behouden. Taak- en handmatige levering worden bij deze stap niet ingeschakeld."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A aprovação mantém a ligação de identidade assinada. A entrega manual e de trabalho não é habilitada nesta etapa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Одобрение сохраняет подписанную привязку идентификационных данных. Доставка заданий и руководств на этом шаге не включается."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "批准会保留已签名的身份绑定。此步骤不会启用工作和手动交付。"
