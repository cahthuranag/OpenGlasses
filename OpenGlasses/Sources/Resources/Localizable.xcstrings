    "Background tasks that run automatically. Search, edit prompts, adjust schedules, and add new tasks." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "مهام الخلفية التي يتم تشغيلها تلقائيًا. البحث وتحرير المطالبات وضبط الجداول الزمنية وإضافة مهام جديدة."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tareas en segundo plano que se ejecutan automáticamente. Busca, edita prompts, ajusta horarios y agrega tareas nuevas."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tâches en arrière-plan qui s'exécutent automatiquement. Rechercher, modifier les invites, ajuster les horaires et ajouter de nouvelles tâches."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Automatikusan futó háttérfeladatok. Keressen, szerkesszen felszólításokat, módosítsa az ütemezéseket és adjon hozzá új feladatokat."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Attività in background eseguite automaticamente. Cerca, modifica le richieste, modifica le pianificazioni e aggiungi nuove attività."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動で実行されるバックグラウンドタスク。検索、プロンプトの編集、スケジュールの調整、新しいタスクの追加。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자동으로 실행되는 백그라운드 작업. 검색하고, 프롬프트를 편집하고, 일정을 조정하고, 새 작업을 추가하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Achtergrondtaken die automatisch worden uitgevoerd. Zoek, bewerk aanwijzingen, pas planningen aan en voeg nieuwe taken toe."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tarefas em segundo plano que são executadas automaticamente. Pesquise, edite prompts, ajuste cronogramas e adicione novas tarefas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Фоновые задачи, которые выполняются автоматически. Ищите, редактируйте запросы, меняйте расписание и добавляйте новые задачи."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自动运行的后台任务。搜索、编辑提示、调整计划并添加新任务。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自動運行的背景任務。搜尋、編輯提示、調整排程以及新增新任務。"
          }
        }
      }
    },
