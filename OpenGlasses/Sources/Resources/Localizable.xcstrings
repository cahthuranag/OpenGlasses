    "The key stays on this phone, in the Keychain. It is never sent to %@'s profile address." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "المفتاح يبقى على هذا الهاتف، في سلسلة المفاتيح. لا يتم إرساله أبدًا إلى عنوان ملف تعريف %1$@."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clave se queda en este celular, en el llavero. Nunca se envía a la dirección del perfil de %@."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La clé reste sur ce téléphone, dans le trousseau. Elle n'est jamais envoyée à l'adresse du profil de %1$@."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A kulcs ezen a telefonon marad, a kulcstartóban. Soha nem küldik el a %1$@ profilcímére."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La chiave rimane su questo telefono, nel portachiavi. Non viene mai inviato all'indirizzo del profilo di %1$@."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "キーはこの電話のキーチェーンに保持されます。%1$@のプロファイルアドレスには送信されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "키는 이 전화기의 키체인에 남아 있습니다. %1$@의 프로필 주소로는 절대 전송되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De sleutel blijft op deze telefoon, in de Sleutelhanger. Hij wordt nooit naar het profieladres van %1$@ gestuurd."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A chave fica neste telefone, no Keychain. Nunca é enviado para o endereço do perfil de %1$@."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ключ остаётся на этом телефоне, в Связке ключей. Он никогда не отправляется по адресу профиля %@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "密钥保存在此电话的钥匙串中。它永远不会发送到%1$@的个人资料地址。"
          }
