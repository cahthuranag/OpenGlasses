    "%@ are locked until you unlock your iPhone." : {
      "comment" : "Memory screen status row: a source cannot be read while the phone is locked.",
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتم قفل %1$@ حتى تقوم بإلغاء قفل iPhone."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%@: bloqueado hasta que desbloquees tu iPhone."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ sont verrouillés jusqu'à ce que vous débloquiez votre iPhone."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A %1$@ zárolva van, amíg fel nem oldja a iPhone zárolását."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ sono bloccati finché non sblocchi il tuo iPhone."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ は、iPhone を解除するまでロックされています。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
