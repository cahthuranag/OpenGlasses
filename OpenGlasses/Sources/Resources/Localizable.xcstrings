        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@는 이러한 설정을 지정하므로 이 전화기에는 표시되지 않습니다. 설정 › 조직은 %2$@가 설정한 내용을 나열합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ stelt deze instellingen in, zodat ze niet op deze telefoon worden weergegeven. Instellingen › Organisatie geeft weer wat %2$@ instelt."
