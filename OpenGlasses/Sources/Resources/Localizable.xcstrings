        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "翻訳された字幕 — あなたの言語で周囲の会話が表示されます。デフォルトではオフ。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "번역된 캡션 — 귀하의 언어로 렌더링된 주변 음성입니다. 기본적으로 꺼져 있습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vertaalde ondertitels — omringende spraak weergegeven in uw taal. Standaard uitgeschakeld."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Legendas traduzidas — fala em torno da fala renderizada em seu idioma. Desativado por padrão."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переведённые субтитры — окружающая речь отображается на вашем языке. По умолчанию выключено."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
