          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ задаёт эти настройки, поэтому на этом телефоне они не показаны. В разделе «Настройки › Организация» перечислено, что задаёт %2$@."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "%1$@ 设置这些设置，因此它们不会显示在此手机上。设置 › 组织列出了 %2$@ 设置的内容。"
