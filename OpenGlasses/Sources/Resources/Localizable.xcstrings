    "Say \"%@\" or tap the mic to start a conversation." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قل \"%1$@\" أو اضغط على الميكروفون لبدء محادثة."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Di “%@” o toca el micrófono para iniciar una conversación."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dites \"%1$@\" ou touchez le micro pour commencer une conversation."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mondja ki, hogy „%1$@”, vagy koppintson a mikrofonra a beszélgetés elindításához."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dì \"%1$@\" o tocca il microfono per avviare una conversazione."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "「%1$@」と言うか、マイクをタップして会話を始めてください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"%1$@\"라고 말하거나 마이크를 탭하여 대화를 시작하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Zeg \"%1$@\" of tik op de microfoon om een gesprek te starten."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diga \"%1$@\" ou toque no microfone para iniciar uma conversa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скажите «%@» или нажмите на микрофон, чтобы начать разговор."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "说“%1$@”或点击麦克风开始对话。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "說「%1$@」或輕觸麥克風開始對話。"
          }
        }
      }
    },
    "Say \"Connecting to Avenkin AI\" at Voice Startup" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قل \"الاتصال بـ Avenkin AI\" عند بدء التشغيل الصوتي"
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Decir “Conectando con Avenkin AI” al iniciar la voz"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dites \"Connexion à Avenkin IA\" au démarrage vocal"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A Voice Indításkor mondja ki: „Connecting to Avenkin AI”."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Dire \"Connessione a Avenkin AI\" all'avvio vocale"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "音声起動時に「Avenkin AIに接続中」と言ってください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voice Startup에서 \"Avenkin AI에 연결 중\"이라고 말하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
