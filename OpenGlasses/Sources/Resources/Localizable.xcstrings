    "Hands-free, domain-grounded guidance for field engineers — load a knowledge vault and run grounded, audited sessions." : {
      "comment" : "A description of Field Assist.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "إرشادات بدون استخدام اليدين ومستندة إلى المجال للمهندسين الميدانيين — تحميل مستودع المعرفة وتشغيل جلسات مؤطرة ومراجعة."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orientación manos libres y fundamentada en su dominio para ingenieros de campo: carga una bóveda de conocimiento y ejecuta sesiones fundamentadas y auditadas."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guidage mains libres, basé sur le domaine, pour les ingénieurs sur le terrain — chargez un coffre de connaissances et exécutez des sessions auditées et basées sur des données."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kihangosított, tartományra földelt útmutatás terepi mérnökök számára – töltsön be egy tudástárolót, és futtasson földelt, auditált munkameneteket."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Guida pratica e basata sul dominio per gli ingegneri sul campo: carica un archivio di conoscenze ed esegui sessioni basate su controlli."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "現場技術者向けのハンズフリーでドメインに基づいたガイダンス — ナレッジボールトを読み込み、基づいた監査済みセッションを実行します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "현장 엔지니어를 위한 핸즈프리 도메인 기반 지침 — 지식 저장소를 로드하고 기반 감사 세션을 실행합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Handsfree, domeingebaseerde begeleiding voor veldingenieurs: laad een kenniskluis en voer gefundeerde, gecontroleerde sessies uit."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Orientação prática e baseada no domínio para engenheiros de campo: carregue um cofre de conhecimento e execute sessões auditadas e fundamentadas."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Голосовые, предметно-обоснованные подсказки для выездных инженеров без использования рук — загрузите хранилище знаний и проводите проверенные, протоколируемые сеансы."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "为现场工程师提供免提且基于领域的指导——加载知识库并运行有依据、可审核的会话。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "為現場工程師提供免提、基於領域的指導 — 載入知識庫並運行有依據、經審核的會話。"
          }
        }
      }
    },
