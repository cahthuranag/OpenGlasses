    "Pauses while your own music plays. The long press and capture button stay with your glasses." : {
      "comment" : "Footer for the Temple Taps settings.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتوقف أثناء تشغيل موسيقاك الخاصة. زر الضغط الطويل وزر الالتقاط يبقي مع نظاراتك."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se pausa mientras se reproduce tu propia música. La pulsación larga y el botón de captura siguen siendo de tus lentes."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se met en pause pendant que votre propre musique joue. La pression longue et le bouton d'enregistrement restent activés sur vos lunettes."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A saját zenéje lejátszása közben szünetel. A hosszan lenyomott és a rögzítés gomb a szemüveged mellett marad."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Mette in pausa mentre viene riprodotta la tua musica. La pressione prolungata e il pulsante di acquisizione rimangono con gli occhiali."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "自分の音楽が再生されている間、一時停止します。長押しとキャプチャボタンはあなたのメガネに残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "자신의 음악이 재생되는 동안 일시 정지됩니다. 길게 누르기와 캡처 버튼은 안경과 함께 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pauzeert terwijl je eigen muziek speelt. De lange druk- en opnameknop blijft bij uw bril."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pausa enquanto sua própria música toca. O toque longo e o botão de captura ficam com seus óculos."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Приостанавливается, пока играет ваша музыка. Долгое нажатие и кнопка съёмки остаются за очками."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当您自己的音乐播放时暂停。长按和捕捉按钮随着您的眼镜保持。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "播放您自己的音樂時會暫停。長按和捕捉按鈕會停留在您的眼鏡上。"
          }
        }
      }
    },
