          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szemüveg kameráját és a TTS-t Claude Code munkamenetnek teszi ki a hálózaton. Csak fejlesztő."
          }
        },
        "it" : {
          "stringUnit" : {
