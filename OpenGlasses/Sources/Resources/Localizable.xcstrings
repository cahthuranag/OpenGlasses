          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Seus manuais estão indexados neste telefone a seguir; isso pode levar alguns minutos para um longo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Далее его руководства индексируются на этом телефоне; для объёмного руководства это может занять несколько минут."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "它的手册已在此手机上建立索引；对于较长的手册可能需要几分钟。"
