    "Per-server outbound data policy, tool trust badges, and recent egress decisions." : {
      "comment" : "A section of MCP Servers that shows the safety and trust of each server.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "سياسة البيانات الصادرة لكل خادم، شارات ثقة الأدوات، وقرارات الخروج الأخيرة."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Política de datos salientes por servidor, insignias de confianza de las herramientas y decisiones recientes de salida de datos."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Selon la politique de données sortantes par serveur, badges de confiance des outils et décisions récentes de sortie."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Szerverenkénti kimenő adatokra vonatkozó szabályzat, az eszközök megbízhatósági jelvényei és a legutóbbi kilépési döntések."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Policy sui dati in uscita per server, badge di attendibilità degli strumenti e recenti decisioni in uscita."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "サーバーごとのアウトバウンドデータポリシー、ツールの信頼バッジ、および最近のエグレスの決定。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "서버별 아웃바운드 데이터 정책, 도구 신뢰 배지 및 최근 송신 결정."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Uitgaand gegevensbeleid per server, tool-vertrouwensbadges en recente beslissingen over uitgaand verkeer."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Política de dados de saída por servidor, emblemas de confiança de ferramentas e decisões recentes de saída."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Политика исходящих данных для каждого сервера, значки доверия инструментов и последние решения по исходящему трафику."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按照服务器出站数据政策、工具信任徽章以及最近的出站决策。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
