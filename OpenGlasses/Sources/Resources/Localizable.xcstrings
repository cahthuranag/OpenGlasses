    "Enter a full ws:// or wss:// Realtime endpoint with a host and no URL credentials or fragment." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "أدخل نقطة اتصال كاملة للوقت الفعلي تبدأ بـ ws:// أو wss:// وتتضمن مضيفًا، دون بيانات اعتماد أو جزء مرجعي في عنوان URL."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ingresa un punto de conexión en tiempo real completo con ws:// o wss://, un host y sin credenciales ni fragmento en la URL."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entrez un point de terminaison complet ws:// ou wss:// en temps réel, avec un hôte et sans identifiants ni fragment dans l’URL."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Adjon meg egy teljes ws:// vagy wss:// valós idejű végpontot gazdagéppel, URL-beli hitelesítő adatok és töredék nélkül."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Inserisci un endpoint in tempo reale completo ws:// o wss:// con un host e senza credenziali o frammenti nell’URL."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ホストを含む完全な ws:// または wss:// リアルタイムエンドポイントを入力してください。URL の認証情報やフラグメントは含めないでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "호스트를 포함하는 전체 ws:// 또는 wss:// 실시간 엔드포인트를 입력하세요. URL 자격 증명이나 프래그먼트는 포함하지 마세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Voer een volledig ws://- of wss://-eindpunt voor realtime in met een host, zonder inloggegevens of fragment in de URL."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Digite um endpoint completo de tempo real com ws:// ou wss://, um host e sem credenciais ou fragmento na URL."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Введите полный адрес ws:// или wss:// для реального времени с именем хоста, без учётных данных и фрагмента в URL."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "请输入完整的 ws:// 或 wss:// 实时端点，包含主机名，不含 URL 凭据或片段。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "請輸入完整的 ws:// 或 wss:// 即時端點，包含主機名稱，不含 URL 憑證或片段。"
          }
        }
      }
    },
