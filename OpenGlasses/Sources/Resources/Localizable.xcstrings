    "AI responses may contain errors. Verify important information independently." : {
      "comment" : "A disclaimer that AI responses may contain errors and that users should verify important information independently.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قد تحتوي استجابات الذكاء الاصطناعي على أخطاء. التحقق من المعلومات الهامة بشكل مستقل."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las respuestas de la IA pueden contener errores. Verifica por tu cuenta la información importante."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les réponses de l'IA peuvent contenir des erreurs. Vérifiez les informations importantes de manière indépendante."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Az AI-válaszok hibákat tartalmazhatnak. A fontos információkat függetlenül ellenőrizze."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le risposte dell'AI potrebbero contenere errori. Verifica le informazioni importanti in modo indipendente."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AIの応答には誤りが含まれる場合があります。重要な情報は独自に確認してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 응답에는 오류가 포함될 수 있습니다. 중요한 정보를 독립적으로 확인합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI-reacties kunnen fouten bevatten. Controleer belangrijke informatie onafhankelijk."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "As respostas da IA podem conter erros. Verifique informações importantes de forma independente."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ответы ИИ могут содержать ошибки. Проверяйте важную информацию самостоятельно."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
