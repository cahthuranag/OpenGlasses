    "Uses the phone's camera. The picture is filed against this job, not sent anywhere." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يستخدم كاميرا الهاتف. يتم حفظ الصورة ضمن هذا العمل، ولا يتم إرسالها إلى أي مكان."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa la cámara del celular. La imagen se archiva en este trabajo; no se envía a ningún lado."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilise l'appareil photo du téléphone. La photo est enregistrée pour ce travail, elle n'est envoyée nulle part."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A telefon kameráját használja. A fénykép ehhez a feladathoz kerül mentésre, nem küldik el sehova."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Utilizza la fotocamera del telefono. L'immagine viene archiviata rispetto a questo lavoro, non inviata da nessuna parte."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "電話のカメラを使用します。撮影した写真はこのジョブに保存され、どこにも送信されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "휴대폰의 카메라를 사용합니다. 사진은 이 작업에 대해 보관되며 어디로도 전송되지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gebruikt de camera van de telefoon. De foto wordt bij dit werk opgeslagen, niet ergens naartoe verzonden."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Usa a câmera do telefone. A foto é arquivada neste trabalho, não enviada para lugar algum."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Использует камеру телефона. Фото прикрепляется к этому заданию и никуда не отправляется."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用手机的摄像头。照片会归档到此任务，而不会发送到任何地方。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "使用手機的相機。圖片會存檔於此工作，而不會傳送到任何地方。"
          }
        }
      }
    },
