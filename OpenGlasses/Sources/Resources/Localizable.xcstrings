    "The start of the file. The whole file is attached — open it from the email or share sheet to read the rest." : {
      "comment" : "Footer for the preview of a support report.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "بداية الملف. الملف كامل مرفق — افتحه من البريد الإلكتروني أو ورقة المشاركة لقراءة الباقي."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "El inicio del archivo. El archivo completo va adjunto; ábrelo desde el correo o la hoja para compartir para leer el resto."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Le début du fichier. Tout le fichier est joint — ouvrez-le depuis l'courriel ou la feuille de partage pour lire le reste."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A fájl kezdete. Az egész fájl csatolva van — nyisd meg az emailből vagy a megosztási menüből, hogy elolvasd a többit."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'inizio del file. L'intero file è allegato: aprilo dall'e-mail o condividi il foglio per leggere il resto."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "ファイルの開始。全ファイルが添付されています — メールまたは共有シートから開いて残りを読んでください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "파일의 시작입니다. 전체 파일이 첨부되어 있습니다. 이메일이나 공유 시트에서 파일을 열어 나머지 내용을 읽어보세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Het begin van het bestand. Het hele bestand is bijgevoegd — open het vanuit de e-mail of het deelmenu om de rest te lezen."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O início do arquivo. O arquivo inteiro está anexado – abra-o no e-mail ou na planilha de compartilhamento para ler o resto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Начало файла. Весь файл прикреплён — откройте его из письма или меню «Поделиться», чтобы прочитать остальное."
          }
        },
        "zh-Hans" : {
