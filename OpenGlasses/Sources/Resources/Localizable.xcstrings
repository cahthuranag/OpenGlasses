    "Stops and saves the recording, and gets it ready to go to the office." : {
      "comment" : "A hint for the stop button.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يقوم بإيقاف التسجيل وحفظه، ويجهزه للإرسال إلى المكتب."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
