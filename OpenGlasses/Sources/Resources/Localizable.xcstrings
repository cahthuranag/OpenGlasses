    "Paste manuals, procedures, or specs. The agent references this material during the playbook." : {
      "comment" : "A description of the reference material section in the playbook editor.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "قم بلصق الكتيبات أو الإجراءات أو المواصفات. يشير الوكيل إلى هذه المواد أثناء دفتر التعليمات."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pega manuales, procedimientos o especificaciones. El agente consulta este material durante el playbook."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Collez les manuels, procédures ou spécifications. L'agent se réfère à ce matériel pendant le carnet de commandes."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Illessze be a kézikönyveket, eljárásokat vagy specifikációkat. Az ügynök hivatkozik erre az anyagra a játékkönyv során."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Incolla manuali, procedure o specifiche. L'agente fa riferimento a questo materiale durante il playbook."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "マニュアル、手順、または仕様書を貼り付けます。エージェントはプレイブック中にこの資料を参照します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "매뉴얼, 절차, 사양을 붙여넣으세요. 상담사는 플레이북 중에 이 자료를 참조합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Plak handleidingen, procedures of specificaties. De agent verwijst naar dit materiaal tijdens het draaiboek."
          }
        },
        "pt-BR" : {
