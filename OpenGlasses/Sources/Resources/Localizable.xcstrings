        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De activatiesleutel die uw bedrijf u heeft gegeven, of de volledige licentiecode. Het opzoeken van een activatiesleutel heeft één keer internet nodig."
          }
