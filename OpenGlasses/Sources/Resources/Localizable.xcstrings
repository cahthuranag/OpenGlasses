    "Recorded exactly as given — never guessed from a work order or tidied up." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "تم التسجيل بالضبط كما هو معطى — لم يتم التخمين من أمر العمل أو ترتيب البيانات."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Se registra exactamente como se dio; nunca se adivina a partir de una orden de trabajo ni se arregla."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistré exactement tel que donné — jamais deviné à partir d'un ordre de travail ou arrangé."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Pontosan úgy rögzítve, ahogy megadták – soha nem találták ki munkamegrendelésből, vagy nem volt rendbe rakva."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registrato esattamente come dato: mai indovinato da un ordine di lavoro o riordinato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "作業指示書から推測せず、整理せずにそのまま記録"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "주어진 대로 정확하게 기록되었습니다. 작업 주문에서 추측하거나 정리한 적이 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Exact zoals gegeven opgenomen — nooit geraadpleegd uit een werkorder of opgeschoond."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registrado exatamente como fornecido – nunca adivinhado em uma ordem de serviço ou arrumado."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записывается точно как указано — никогда не угадывается по наряду и не приводится в порядок."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "按原样记录——从未根据工作订单猜测或整理。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "精確錄製所給內容——從不根據工作單猜測或整理。"
          }
        }
      }
    },
