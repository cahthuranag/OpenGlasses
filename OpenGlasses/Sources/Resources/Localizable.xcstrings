    "Fills in the report and opens it. Nothing leaves the phone until you tap Send." : {
      "comment" : "A button that fills in a report and opens it.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يملأ التقرير ويفتحه. لا يغادر شيء الهاتف حتى تضغط إرسال."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Llena el reporte y lo abre. Nada sale del celular hasta que tocas Enviar."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Remplit le rapport et l’ouvre. Rien ne quitte le téléphone jusqu’à ce que vous appuyiez sur Envoyer."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kitölti a jelentést és megnyitja. Semmi sem hagyja el a telefont, amíg meg nem koppint a Küldés elemre."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Compila il report e lo apre. Niente lascia il telefono finché non tocchi Invia."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "レポートに記入して開きます。送信をタップするまで、何も電話から送信されません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "보고서를 작성하고 엽니다. 보내기를 탭하기 전까지는 아무것도 전화기에서 나가지 않습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Vult het rapport in en opent het. Niets verlaat de telefoon totdat u op Verzenden tikt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Preenche o relatório e abre-o. Nada sai do telefone até você tocar em Enviar."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Заполняет отчёт и открывает его. Ничего не покидает телефон, пока вы не нажмёте «Отправить»."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "填写报告并打开它。在你点击发送之前，任何内容都不会离开手机。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "填寫報告並打開。直到你點擊「發送」之前，資料不會離開電話。"
          }
        }
      }
    },
