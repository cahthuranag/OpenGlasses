        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta es una estimación de la IA generada a partir de una sola vista de la cámara. No es una medición, una inspección ni una certificación, y nada fuera de esa vista fue evaluado."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Il s’agit d’une estimation IA produite à partir d’une seule vue de caméra. Ce n’est pas une mesure, une inspection ou une certification, et tout ce qui se trouve en dehors de cette vue n’a pas été évalué."
          }
