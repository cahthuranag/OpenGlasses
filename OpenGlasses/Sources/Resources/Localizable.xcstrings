        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A %1$@ beállítja ezeket a beállításokat, így ezen a telefonon nem jelennek meg. Beállítások › A szervezet felsorolja, hogy mit állít be a %2$@."
