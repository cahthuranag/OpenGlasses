    "Opens each one in turn. Anything you cancel stays here." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يفتح كل واحد بالتتابع. أي شيء تلغيه يبقى هنا."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre cada uno por turno. Lo que canceles se queda aquí."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ouvre chacun à son tour. Tout ce que vous annulez reste ici."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Egymás után nyitja meg mindegyiket. Bármi, amit lemond, itt marad."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Li apre ciascuno a turno. Tutto ciò che annulli rimane qui."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "順番にそれぞれを開きます。キャンセルしたものはここに残ります。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "차례로 열어봅니다. 취소한 모든 항목은 여기에 유지됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opent ze allemaal om de beurt. Alles wat je annuleert, blijft hier staan."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Abre cada um por vez. Tudo o que você cancelar fica aqui."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Открывает их по очереди. Всё, что вы отмените, останется здесь."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "依次打开每一个。任何取消的内容会保留在这里。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "依次打開每一個。任何你取消的項目都會保留在這裡。"
          }
        }
      }
    },
