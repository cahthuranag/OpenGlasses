    "Copy or share the report if you'd rather send it another way." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انسخ التقرير أو شاركه إذا كنت تفضل إرساله بطريقة أخرى."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia o comparte el reporte si prefieres enviarlo de otra forma."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copiez ou partagez le rapport si vous préférez l'envoyer d'une autre manière."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Másolja ki vagy ossza meg a jelentést, ha inkább más módon szeretné elküldeni."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copia o condividi il rapporto se preferisci inviarlo in un altro modo."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "別の方法で送信したい場合は、レポートをコピーまたは共有してください。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "다른 방법으로 보내고 싶다면 보고서를 복사하거나 공유하세요."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Kopieer of deel het rapport als u het liever op een andere manier verzendt."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Copie ou compartilhe o relatório se preferir enviá-lo de outra forma."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Скопируйте или поделитесь отчётом, если хотите отправить его иначе."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果您想用其他方式发送，可以复制或分享报告。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "如果您想用其他方式傳送，請複製或分享報告。"
          }
        }
      }
    },
