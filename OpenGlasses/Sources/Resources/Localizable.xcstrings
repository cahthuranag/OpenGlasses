    "The instruction the AI runs on schedule. If there's nothing to report, it stays silent." : {
      "comment" : "A description of the prompt of a task.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التعليمات التي يعمل بها الذكاء الاصطناعي وفق الجدول. إذا لم يكن هناك شيء للتقرير، فإنه يبقى صامتًا."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La instrucción que la IA ejecuta según lo programado. Si no hay nada que reportar, se queda en silencio."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'instruction selon laquelle l'IA fonctionne selon le calendrier. S'il n'y a rien à signaler, elle reste silencieuse."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A utasítás, amit az AI az ütemterv szerint végrehajt. Ha nincs jelenteni való, csendben marad."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "L'istruzione che l'IA esegue nei tempi previsti. Se non c'è niente da segnalare resta in silenzio."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI がスケジュールに基づいて実行する指示。報告する内容がなければ、何も言いません。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI가 일정에 따라 실행하는 명령입니다. 신고할 게 없으면 침묵합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "De instructie wordt door de AI volgens schema uitgevoerd. Als er niets te melden is, blijft hij stil."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A instrução que a IA executa dentro do cronograma. Se não há nada a relatar, fica em silêncio."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Инструкция, которую ИИ выполняет по расписанию. Если сообщать не о чем, он молчит."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 按计划运行的指令。如果没有要报告的内容，它将保持沉默。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "AI 按排程執行的指令。如果沒什麼可回報，它會保持沉默。"
          }
        }
      }
    },
    "The instruction the AI runs on schedule. Write it like you're talking to the assistant." : {
      "comment" : "A description of the prompt field in a task detail view.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
