    "\"Share the transcript\" or \"Export the recording\"" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"مشاركة النص\" أو \"تصدير التسجيل\""
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "“Comparte la transcripción” o “Exporta la grabación”"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "« Partager la transcription » ou « Exporter l'enregistrement »"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "„Ossza meg az átiratot” vagy „Exportálja a felvételt”"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "\"Condividi la trascrizione\" o \"Esporta la registrazione\""
          }
        },
        "ja" : {
