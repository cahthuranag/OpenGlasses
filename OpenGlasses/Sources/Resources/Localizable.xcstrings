    "Recordings, transcripts, audit log and exports unreadable while the phone is locked" : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "التسجيلات والنصوص وسجل التدقيق والتصديرات غير قابلة للقراءة أثناء قفل الهاتف"
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grabaciones, transcripciones, registro de auditoría y exportaciones ilegibles mientras el celular está bloqueado"
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistrements, transcriptions, journal d'audit et exportations illisibles lorsque le téléphone est verrouillé"
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A felvételek, az átiratok, az auditnapló és az exportálás olvashatatlan, amíg a telefon le van zárva"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registrazioni, trascrizioni, registri di controllo ed esportazioni illeggibili mentre il telefono è bloccato"
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "電話がロックされている間、録画、文字起こし、監査ログおよびエクスポートは読み取れません"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "전화기가 잠겨 있는 동안에는 녹음, 스크립트, 감사 로그 및 내보내기를 읽을 수 없습니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Opnamen, transcripties, auditlog en exports onleesbaar terwijl de telefoon vergrendeld is"
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Gravações, transcrições, registros de auditoria e exportações ilegíveis enquanto o telefone está bloqueado"
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записи, расшифровки, журнал аудита и экспортированные файлы недоступны для чтения, пока телефон заблокирован"
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "当手机锁定时，录音、转录、审核日志和导出文件无法读取"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "當手機鎖定時，錄製檔案、文字記錄、審計日誌和匯出檔案無法閱讀"
          }
        }
      }
    },
    "Records sound and pictures from the glasses for your office. You are told what that means first." : {
      "comment" : "A hint for the record button on a job's page.",
      "isCommentAutoGenerated" : true,
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يسجل الصوت والصور من النظارات لمكتبك. يتم إخطارك بما يعنيه ذلك أولاً."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Graba sonido e imágenes desde los lentes para tu oficina. Primero se te explica qué significa."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Enregistre le son et les images des lunettes pour votre bureau. On vous explique d'abord ce que cela signifie."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Hangot és képeket rögzít az irodai szemüvegről. Először megmondják, hogy ez mit jelent."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Registra suoni e immagini dagli occhiali per il tuo ufficio. Ti viene detto prima cosa significa."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "オフィス用に眼鏡から音声と映像を記録します。最初にその意味を説明されます。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "사무실용 안경의 소리와 사진을 녹음합니다. 그것이 무엇을 의미하는지 먼저 듣게 됩니다."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Neemt geluid en beelden op van de bril voor uw kantoor. U wordt eerst verteld wat dat betekent."
          }
        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Grava sons e imagens dos óculos para o seu escritório. Você será informado sobre o que isso significa primeiro."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Записывает звук и изображение с очков для вашего офиса. Сначала вам объяснят, что это значит."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "记录从眼镜捕捉的声音和图像供办公室使用。首先会告诉你这意味着什么。"
          }
        },
        "zh-Hant" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "從眼鏡錄製聲音和影像給您的辦公室。首先會告訴您這意味著什麼。"
          }
        }
      }
    },
    "Records that this job has no number. The report still goes out and you won't be asked again." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يسجل أن هذه الوظيفة ليس لها رقم. التقرير لا يزال يرسل ولن يُطلب منك مرة أخرى."
          }
        },
        "es-MX" : {
