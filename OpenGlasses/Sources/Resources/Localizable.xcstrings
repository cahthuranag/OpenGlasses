        },
        "pt-BR" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "O espelho fornece conteúdo do HUD pela rede, portanto, o modo HIPAA o desativa."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Зеркало передаёт содержимое HUD по сети, поэтому режим HIPAA полностью его отключает."
          }
        },
        "zh-Hans" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "镜像通过网络提供HUD内容，因此HIPAA模式会彻底禁用它。"
