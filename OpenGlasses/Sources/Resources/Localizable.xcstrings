          }
        }
      }
    },
    "Double-tap for why it was recommended and what was recorded against it." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "انقر مرتين لمعرفة سبب التوصية وما تم تسجيله ضده."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Toca dos veces para ver por qué se recomendó y qué se registró al respecto."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Appuyez deux fois pour savoir pourquoi cela a été recommandé et ce qui a été enregistré contre cela."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Koppintson duplán, hogy megtudja, miért javasolták, és mit rögzítettek ellene."
