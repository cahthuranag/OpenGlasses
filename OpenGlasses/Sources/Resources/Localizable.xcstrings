            "value" : "كل ما قيل اليوم حتى الآن، للدعم. أنت تقرأه قبل إرساله."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Todo lo que se ha dicho hoy hasta ahora, para soporte. Lo lees antes de que se envíe."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tout ce qui a été dit aujourd'hui jusqu'à présent, pour le support. Vous le lisez avant qu'il ne soit envoyé."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Minden, amit ma elmondtunk eddig, támogatásként. Olvassa el, mielőtt elküldi."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tutto quello che è stato detto oggi finora, per il supporto. Lo leggi prima che venga inviato."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "今日これまでに言われたすべてのこと（サポート用）。送信される前にあなたが確認します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "지원을 위해 오늘까지 말한 모든 내용입니다. 보내기 전에 읽어보세요."
