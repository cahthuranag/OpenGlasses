    "Recognizes ASL fingerspelling through the glasses camera and speaks the words — on-device, independent of Reading Accessibility." : {
      "localizations" : {
        "ar" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "يتعرف على تهجئة الأصابع بلغة الإشارة الأمريكية من خلال كاميرا النظارات وينطق الكلمات — على الجهاز، مستقل عن إمكانية الوصول للقراءة."
          }
        },
        "es-MX" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reconoce el deletreo manual de ASL mediante la cámara de los lentes y dice las palabras; en el dispositivo, independiente de la accesibilidad de lectura."
          }
        },
        "fr-CA" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Reconnaît l'alphabet manuel ASL à travers la caméra des lunettes et prononce les mots — sur l'appareil, indépendamment de l'accessibilité à la lecture."
          }
        },
        "hu" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A szemüveg kameráján keresztül felismeri az ASL ujjal történő helyesírást, és kimondja a szavakat – az eszközön, az olvasási kisegítő lehetőségektől függetlenül."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Riconosce l'ortografia ASL attraverso la fotocamera degli occhiali e pronuncia le parole sul dispositivo, indipendentemente dall'accessibilità della lettura."
          }
        },
        "ja" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "メガネのカメラを通じてASL文字つづりを認識し、単語を音声で話します — デバイス上で、読み取り支援機能に依存せずに動作します。"
          }
        },
        "ko" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "안경 카메라를 통해 ASL 손가락 철자를 인식하고 읽기 접근성과 관계없이 기기에서 단어를 말합니다."
          }
        },
        "nl" : {
          "stringUnit" : {
